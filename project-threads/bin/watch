#!/usr/bin/env bash
# waiting を報告した thread が、完了見込みの時刻を過ぎても次の報告をしていなければ、coordinator に知らせる。
# 一度も報告していない thread の会話の記録が STALL_MIN 分更新されていなければ、止まっているとみて同じく知らせる。
# coordinator の会話が止まっていれば、prompt cache が切れる前に、延ばす時間帯（既定は平日 9〜21 時）なら短い入力を送って cache を
# 延ばし、時間帯の外で会話が大きければ知らせて、user に引き継ぎを提案させる（check_cache）。
# open が coordinator の terminal の子として起動し、coordinator の claude の PID を渡す。見張りはこの PID のプロセスが
# 終わったら終わるので、coordinator が動いている間だけ見張り、coordinator が止まっていた間に過ぎたものは、次に開いたときの
# 見張りで知らせる。
# hc の子が親と一緒に終わるのは、親の terminal の program が終わったときだけ。user は terminal のシェルで open を打つので、
# program はそのシェルで、claude が終わってシェルに戻っても terminal は終わらない。hc に任せると、開き直すたびに見張りが増える。
# 同じ project の見張りは 1 本にする。起動したら、前の見張りが動いていれば止めて、PID を project の watch.pid に書く。
# watch.pid が自分の PID でなくなった見張りは終わる（ほぼ同時に 2 本起動して、互いに止め合わなかったとき）。
#
# 常駐するので、1 周期の負担を小さく保つ。知らせる相手が無い周期で起動するのは、全 thread の status.json を
# まとめて読む jq 1 回（thread が無ければ 0 回）と sleep だけ。まだ報告していない thread があれば、その thread.json を
# まとめて読む jq 1 回と、会話の記録の古さを見る find 1 回が足される。coordinator の会話の記録は、最後の応答から 50 分たつ
# 時刻にだけ読む（check_cache）。coordinator と watch.pid の確かめはシェルの組み込みで済ませる。
# coordinator の terminal の確かめ（hc get）や thread の terminal の確かめは、知らせる候補があるときだけ行う。
#
# usage: watch <project のフォルダ> <coordinator の PID> [--once]
#   coordinator の PID  open は自分の PID を渡す。open はこの後 claude を exec するので、同じ PID が coordinator の claude になる
#   --once  1 回だけ見て終わる（テスト用）
set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 || ! -f "$1/project.json" || ! "$2" =~ ^[0-9]+$ || ( $# -eq 3 && "$3" != "--once" ) ]]; then
  echo "usage: $0 <project のフォルダ> <coordinator の PID> [--once]" >&2
  exit 1
fi
PROJECT_DIR="$(cd "$1" && pwd)"
# 前の見張りを見分けるのに、ps に出る引数と比べる。open は毎回同じ形で渡すので、渡されたままの形で比べる
PROJECT_ARG="$1"
COORDINATOR_PID="$2"
ONCE="${3:-}"
# 知らせが見込みの時刻から遅れるのは、最大でこの間隔ぶん
INTERVAL=60
# 知らせ済みの印。中身は見張りの印（報告の時刻と見込みの組）1 行で、読むのにプロセスを起動しない
MARK=overdue-notified
# 動いている見張りの PID
PID_FILE="$PROJECT_DIR/watch.pid"
# 一度も報告していない thread を止まっているとみなす、会話の記録が更新されていない分数。thread は 5 分を超える待ちの前に
# waiting を報告する決まりなので、報告の無いまま記録が 10 分止まるのは、起動直後の取り消しで brief が入力欄に戻った（t044）か、
# 報告せずに止まったとき
STALL_MIN=10
# 止まっていると知らせ済みの印。thread ごとに 1 回だけ知らせる
STALL_MARK=stall-notified
# coordinator の最後の応答からこの分数がたったら、延ばす時間帯（_lib.sh の keepalive_hours）なら cache を延ばす入力を送り、
# 時間帯の外で context が CACHE_NOTICE_MIN_TOKENS 以上なら、引き継ぎを提案させる知らせを送る。
# cache の寿命は最後の要求の開始から 1 時間で、応答の行の時刻は要求の開始より最大 4 分半ほど遅い（_lib.sh の last_api_call_epoch）ので、
# CACHE_NOTICE_LATEST_MIN 分を過ぎたらどちらも送らない。切れた後に送ると、受けたターンが会話の全体を書き直す
CACHE_NOTICE_IDLE_MIN=50
CACHE_NOTICE_LATEST_MIN=55
CACHE_NOTICE_MIN_TOKENS=200000
# 次に coordinator の会話の記録を読む時刻（SECONDS）と、そのとき見ていた会話の id。読むのは、最後に読んだ応答の時刻から
# CACHE_NOTICE_IDLE_MIN 分たったとき。その間に新しい応答があっても、その応答から CACHE_NOTICE_IDLE_MIN 分たつのはもっと後なので
# 見逃さない。記録の更新時刻では決めない: Claude Code は止まっている会話の記録も先頭の metadata の行を書き直し、行が増えないまま
# 更新時刻が進む（2026-11-17 に、最後の応答の約 41 分後に進んだ）ので、50 分たったかを更新時刻で見ると機会を見送る
CACHE_DUE=0
CACHE_SESSION=""
# cache を延ばす入力。開き直す前の coordinator（古い指示のまま）にも通じるよう、対応を本文に書く。
# 指示の「[project-threads …] で始まる知らせは user の指示ではない」に当たる目印で始める
KEEPALIVE_TEXT='[project-threads keepalive] 営業時間中に coordinator の prompt cache が切れないよう、見張りが送った入力です。user の指示ではありません。ツールを呼ばず、返事は「.」の 1 文字だけにしてターンを終えてください'
# 延ばした・延ばさなかったことを、cache が切れそうになった機会（会話と最後の応答の組）ごとに 1 行ずつ残す。効果を後で数えるため
KEEPALIVE_LOG="$PROJECT_DIR/keepalive.log"
# いま扱っている機会。「<会話の id> <最後の応答の epoch 秒> <状態>」の 1 行で、状態は decided（記録に残した）か
# waiting-<理由>（送れずに次の周期で見直す）。見張りが入れ替わっても同じ機会を 2 度記録しないよう、ファイルに置く
KEEPALIVE_STATE="$PROJECT_DIR/keepalive-state"
# 前の周期に見た、空でない入力欄の中身。次の周期（INTERVAL 秒後。_lib.sh の DRAFT_WAIT_SEC と同じ 60 秒）にも同じなら、
# 人が書きかけを置いたまま離れたか、入力の候補とみて、退避してから送る
KEEPALIVE_DRAFT=""
# thread の PR を見る間隔（秒）。merge queue のマージまで 15〜27 分かかる（zumen-engine の実測）のに比べて遅れは小さく、
# gh は 1 project で 1 時間に 12 回（repo ごとに 1 回）で済む。PR_DUE は次に見る時刻（SECONDS）。0 なので起動した周期にすぐ見る
# （coordinator が止まっていた間の変化を拾う）
PR_INTERVAL=300
PR_DUE=0

MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"

# 見込みを過ぎた waiting の報告ごとに「thread のフォルダ<TAB>見張りの印」を出す。印は報告の時刻と見込みの組なので、
# 次の報告があれば別の見張りになり、また知らせられる
OVERDUE_FILTER='
  select(.status == "waiting" and .expectedAt != null and (.expectedAt | fromdateiso8601) <= now)
  | "\(input_filename | rtrimstr("/status.json"))\texpected \(.at) \(.expectedAt)"
'

# <フィルタ> を全ファイルにまとめて 1 回の jq で当て、出力を JQ_OUT に入れる。
# $(...) にするのは、プロセス置換やパイプだとサブシェルが増えるため
jq_all() { # <フィルタ> <ファイル...>
  local filter="$1" file
  shift
  JQ_OUT="$(jq -r "$filter" "$@" 2>/dev/null)" && return 0
  # 読めないファイルがあると jq はそこで止まるので、そのときだけ 1 つずつ読み直し、読めないものを飛ばす
  JQ_OUT=""
  for file in "$@"; do
    if ! JQ_OUT+="$(jq -r "$filter" "$file")"$'\n'; then
      echo "$file を読めません" >&2
    fi
  done
}

# 見込みを過ぎた報告を OVERDUE に入れる。jq は全 thread の status.json をまとめて 1 回だけ起動する
overdue_reports() {
  local files=() file
  OVERDUE=""
  for file in "$PROJECT_DIR"/threads/t*/status.json; do
    if [[ -f "$file" ]]; then files+=("$file"); fi
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  jq_all "$OVERDUE_FILTER" "${files[@]}"
  OVERDUE="$JQ_OUT"
}

# thread の terminal の様子を TERMINAL_STATE に「<terminal> <state>・<status>」か「<terminal> 見つからない」の形で、
# hc の状態（status.state。無ければ空）を TERMINAL_STATUS に入れる。coordinator は一覧を見られないので、知らせに添える
terminal_state_of() { # <thread のフォルダ>
  local terminal got
  TERMINAL_STATUS=""
  terminal="$(jq -r '.terminal // empty' "$1/thread.json")"
  if [[ -n "$terminal" ]] && got="$(hc get "$terminal" --json 2>/dev/null)"; then
    { IFS= read -r TERMINAL_STATE; IFS= read -r TERMINAL_STATUS; } <<<"$(jq -r '
      (.state + (if .status.state then "・" + .status.state else "" end)), (.status.state // "")
    ' <<<"$got")"
    TERMINAL_STATE="$terminal $TERMINAL_STATE"
  else
    TERMINAL_STATE="$terminal 見つからない"
  fi
}

# 知らせを送る coordinator の terminal を COORDINATOR に入れる。coordinator の claude が動いていなければ失敗する。
# 送れないときは印を書かず、次の見張りで送り直す
coordinator_ready() {
  COORDINATOR="$(jq -r '.coordinator.terminal // empty' "$PROJECT_DIR/project.json")"
  [[ -n "$COORDINATOR" ]] && is_claude_with "$COORDINATOR" "$PROJECT_DIR/coordinator-prompt.md"
}

overdue_notice() { # <thread のフォルダ>
  local dir="$1"
  terminal_state_of "$dir"
  jq -r --arg id "${dir##*/}" --arg state "$TERMINAL_STATE" '
    def clock: fromdateiso8601 | strflocaltime("%H:%M");
    "[thread \($id) overdue] 完了見込みの時刻（\(.expectedAt | clock)）を過ぎても報告がありません。"
    + "最後の報告: \(.status) — \(.summary)（\(.at | clock)）。thread の terminal: \($state)。message で進み具合を聞いてください（返事を待つ間は user に知らせなくてよい）。"
    + "聞いても報告が無い、または thread の terminal が live でないなら user に伝えてください。"
  ' "$dir/status.json"
}

# この見張りが続けてよいか。coordinator の claude が動いていて、watch.pid が自分の PID のときだけ続ける。
# どちらもシェルの組み込みで確かめ、プロセスを起動しない
in_charge() {
  local owner=""
  kill -0 "$COORDINATOR_PID" 2>/dev/null || return 1
  if [[ -f "$PID_FILE" ]]; then read -r owner < "$PID_FILE" || owner=""; fi
  [[ "$owner" == "$$" ]]
}

# 同じ project の前の見張りが動いていれば止め、この見張りの PID を watch.pid に書く。
# 前の見張りは前の coordinator の PID を見ているので、開き直した後は次の周期で自分から終わるが、最大 INTERVAL 秒残り、
# coordinator が別の terminal でまだ動いていれば終わらない。残っている間に同じ知らせを送らないよう、ここで止める。
# watch.pid の PID は、見張りが止まった後にほかのプロセスに使い回されることがあるので、ps で同じ project の見張りと確かめてから止める
replace_previous_watch() {
  local previous="" command
  if [[ -f "$PID_FILE" ]]; then read -r previous < "$PID_FILE" || previous=""; fi
  if [[ "$previous" =~ ^[0-9]+$ && "$previous" != "$$" ]] && kill -0 "$previous" 2>/dev/null &&
    command="$(ps -o command= -p "$previous")" && [[ "$command" == *"/bin/watch $PROJECT_ARG "* ]]; then
    # hc の子の見張りは自分のプロセスグループの先頭なので、グループごと止め、待っている sleep を最大 INTERVAL 秒残さない。
    # 先頭でなければ（テストで裏で起動したときなど）見張りだけを止める。確かめた後に前の見張りが自分で終わっていると
    # どちらも失敗するが、止める目的は果たしている
    kill -- "-$previous" 2>/dev/null || kill "$previous" 2>/dev/null || true
  fi
  printf '%s\n' "$$" > "$PID_FILE"
}

check_overdue() {
  local dir key notified pending=()
  overdue_reports
  while IFS=$'\t' read -r dir key; do
    [[ -n "$dir" ]] || continue
    notified=""
    # 印は改行で終わるように書くので、read が失敗するのは空のときだけ
    if [[ -f "$dir/$MARK" ]]; then read -r notified < "$dir/$MARK" || notified=""; fi
    if [[ "$key" != "$notified" ]]; then pending+=("$dir"$'\t'"$key"); fi
  done <<<"$OVERDUE"
  [[ ${#pending[@]} -gt 0 ]] || return 0

  coordinator_ready || return 0
  local entry
  for entry in "${pending[@]}"; do
    # 1 件送るのに数十秒かかることがある（書きかけを待つ）。その間に新しい見張りに替わっていたら、残りはそちらに任せる
    in_charge || return 0
    dir="${entry%%$'\t'*}"
    key="${entry#*$'\t'}"
    if ! send_keeping_draft "$COORDINATOR" "$(overdue_notice "$dir")" >/dev/null; then
      echo "${dir##*/} の報告の遅れを coordinator に送れませんでした。次の見張りで送り直します" >&2
      continue
    fi
    printf '%s\n' "$key" > "$dir/$MARK"
  done
}

# 一度も報告が無く（status.json が無い）、会話の記録が STALL_MIN 分より前から更新されていない thread を、
# 「thread のフォルダ<TAB>会話の記録」の行で STALLED に入れる。知らせ済みの印がある thread と、会話の記録が
# 見つからない thread（会話の id が無い・記録が消えた）は除く
stalled_threads() {
  local dir files=() session transcript dirs=() transcripts=() stale="" i
  STALLED=""
  for dir in "$PROJECT_DIR"/threads/t*; do
    if [[ -f "$dir/thread.json" && ! -e "$dir/status.json" && ! -e "$dir/$STALL_MARK" ]]; then files+=("$dir/thread.json"); fi
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  jq_all '"\(input_filename | rtrimstr("/thread.json"))\t\(.sessionId // "")"' "${files[@]}"
  while IFS=$'\t' read -r dir session; do
    [[ -n "$session" ]] || continue
    transcript="$(transcript_of "$session")" || continue
    dirs+=("$dir")
    transcripts+=("$transcript")
  done <<<"$JQ_OUT"
  [[ ${#transcripts[@]} -gt 0 ]] || return 0
  # 調べる間に記録が消えると find は失敗するが、ほかの記録の結果は出す
  stale="$(find "${transcripts[@]}" -mmin "+$STALL_MIN")" || true
  for ((i = 0; i < ${#transcripts[@]}; i++)); do
    if [[ $'\n'"$stale"$'\n' == *$'\n'"${transcripts[i]}"$'\n'* ]]; then
      STALLED+="${dirs[i]}"$'\t'"${transcripts[i]}"$'\n'
    fi
  done
}

stalled_notice() { # <thread のフォルダ> <会話の記録> <thread の terminal の様子>
  local updated
  updated="$(date -r "$2" +%H:%M)"
  printf '%s' "[thread ${1##*/} stalled] 起動してから一度も報告が無く、会話の記録が ${STALL_MIN} 分以上更新されていません（最後の更新 ${updated}）。thread の terminal: ${3}。message で進み具合を聞いてください（brief が届かないまま止まっていた thread は、それを受けて作業フォルダの brief.md から着手します）。聞いても報告が無い、または thread の terminal が live でないなら user に伝えてください。"
}

# 一度も報告していないまま止まっている thread を coordinator に知らせる。最初のターンが取り消されて brief が入力欄に
# 戻った thread（t044）や、報告せずに止まった thread を、原因を問わず拾う。許可の確認などで止まっている（hc の状態が
# blocked）thread は、sidebar の「Needs you」と macOS の通知で user に見えているので知らせない（許可が済んだ後も
# 止まっていれば、次の見張りで知らせる）
check_stalled() {
  local dir transcript state entry pending=()
  stalled_threads
  while IFS=$'\t' read -r dir transcript; do
    [[ -n "$dir" ]] || continue
    terminal_state_of "$dir"
    [[ "$TERMINAL_STATUS" != blocked ]] || continue
    pending+=("$dir"$'\t'"$transcript"$'\t'"$TERMINAL_STATE")
  done <<<"$STALLED"
  [[ ${#pending[@]} -gt 0 ]] || return 0

  coordinator_ready || return 0
  for entry in "${pending[@]}"; do
    in_charge || return 0
    IFS=$'\t' read -r dir transcript state <<<"$entry"
    if ! send_keeping_draft "$COORDINATOR" "$(stalled_notice "$dir" "$transcript" "$state")" >/dev/null; then
      echo "${dir##*/} が止まっていることを coordinator に送れませんでした。次の見張りで送り直します" >&2
      continue
    fi
    : > "$dir/$STALL_MARK"
  done
}

# この機会（会話と最後の応答の組）の状態を REPLY に入れる。KEEPALIVE_STATE が別の機会のものなら空
keepalive_state_of() { # <会話の id> <最後の応答の epoch 秒>
  local session="" last=""
  REPLY=""
  if [[ -f "$KEEPALIVE_STATE" ]]; then read -r session last REPLY < "$KEEPALIVE_STATE" || true; fi
  [[ "$session $last" == "$1 $2" ]] || REPLY=""
}

# この機会を記録に 1 行足して済ませる。済んでいれば足さない。列はタブ区切りで、時刻・project・結果（sent / skipped）・
# 理由（sent は、入力欄が空なら -、書きかけを退避したら stash、候補だったら suggestion）・最後の応答からの分・context・会話の id
keepalive_decided() { # <会話の id> <最後の応答の epoch 秒> <結果> <理由> <分> <context>
  keepalive_state_of "$1" "$2"
  [[ "$REPLY" != decided ]] || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "${PROJECT_DIR##*/}" "$3" "$4" "$5" "$6" "$1" >> "$KEEPALIVE_LOG"
  printf '%s %s decided\n' "$1" "$2" > "$KEEPALIVE_STATE"
}

# いま送れない理由を残し、次の周期で見直す。CACHE_NOTICE_LATEST_MIN 分を過ぎても送れなければ、この理由で記録に残す
keepalive_waiting() { # <会話の id> <最後の応答の epoch 秒> <理由>
  printf '%s %s waiting-%s\n' "$1" "$2" "$3" > "$KEEPALIVE_STATE"
  CACHE_DUE=0
}

# 延ばす時間帯なら、prompt cache が切れる前に coordinator へ短い入力を送り、cache を 1 時間延ばす。切れた後の最初の入力は
# 会話の全体を書き直し（opus 5.5 では書き込みが読み込みの 40 倍の単価。150k で約 1 ドル）、延ばす入力は読むだけ（約 0.04 ドル）で済む。
# coordinator 自身の要求なので、前置き（system prompt・ツール・履歴）は必ず同じで、statusline の cache の残りと一覧の丸もそのまま正しい。
# ターンが終わるので、見ていない coordinator では herdr-app の通知（toast と完了の音）が出うる。会話を headless で分岐させて
# 読ませる形（claude -p --resume --fork-session）なら画面に触れないが、coordinator と同じ版の実行ファイル・同じ引数で呼ばないと
# 前置きが合わず、外れるたびに会話の全体を書き直すので、この形にしている。
# 時間帯の外なら何もせずに失敗し、呼び出し側は引き継ぎの提案に回る。時間帯の中なら、送れなくても成功する（引き継ぎの提案は送らない。
# 延ばす見込みがあるときに「あと数分で切れる」と知らせると、要らない引き継ぎを提案させる）。
# 時間帯は送る時刻で見るので、9 時より前に使われた会話も 9 時を過ぎてから延ばす。機会を逃した後に初めて見た機会は、逃した時刻
# （最後の応答から CACHE_NOTICE_IDLE_MIN 分）で見る。
# 送らないとき:
#   - 利用枠を超えて usage credits を使っている（最後の要求の cache の寿命が 1h でない。5m なら既に切れている）、
#     利用枠の上限などで最後の応答が API のエラー: 送っても読めないか断られる
#   - 作業中（要求のたびに延びる）・許可待ちなど、待ちでない: 次の周期で見直す
#   - 退避（input_box_stashed）がある: Ctrl+S は前の退避を上書きするか取り出し、送ると退避が入力欄に戻る。次の周期で見直す
#   - 入力欄が空でなく、前の周期から変わった（人が打っている途中かもしれない）: 次の周期で見直す
# 入力欄が前の周期から変わらなければ Ctrl+S を押してから送る。中身は人の書きかけか、claude が turn の後に出す次の入力の候補
# （灰色の文字。hc read は色を落とすので見分けられない）。書きかけなら退避され、送った後に claude が入力欄へ戻す。候補なら
# Ctrl+S は何もせず、hc send の本文は候補とつながらずに届く（2.1.327 で確認）。押す前に見分けられないので、候補でも 1 周期待つ。
# 押すのは send_keeping_draft と同じく、入力欄が DRAFT_WAIT_SEC 秒変わらなかったときだけにし、打っている途中の入力欄を消さない。
# send_keeping_draft を使わないのは、入力欄が変わり続けると最大 DRAFT_GIVE_UP_SEC 秒この周期を止め、その後は退避せずに送って
# 書きかけと混ぜるため。人が打っていれば、その人の送信で cache は延びる
keep_cache_warm() { # <会話の id> <最後の応答の epoch 秒> <分> <context> <時間帯> <曜日> <時刻> <会話の記録>
  local session="$1" last="$2" idle="$3" tokens="$4" weekday="$6" hhmm="$7" state request screen box reason=-
  keepalive_state_of "$session" "$last"
  state="$REPLY"
  if ((idle >= CACHE_NOTICE_LATEST_MIN)) && [[ "$state" != decided ]]; then
    read -r weekday hhmm <<<"$(date -r $((last + CACHE_NOTICE_IDLE_MIN * 60)) '+%u %H%M')"
  fi
  if ! hours_cover "$5" "$weekday" "$hhmm"; then
    keepalive_decided "$session" "$last" skipped outside-hours "$idle" "$tokens"
    return 1
  fi
  [[ "$state" != decided ]] || return 0
  if ((idle >= CACHE_NOTICE_LATEST_MIN)); then
    if [[ "$state" == waiting-* ]]; then state="${state#waiting-}"; else state=late; fi
    keepalive_decided "$session" "$last" skipped "$state" "$idle" "$tokens"
    return 0
  fi
  # 最後の要求の cache の寿命（cacheControl の最後の ttl）と、最後の応答が API のエラーかを「<寿命> <true|false>」で読む
  request="$(grep -E '"type":"(assistant|api-request)"' "$8" | tail -n 50 | jq -Rnr '
    [inputs | fromjson? | select(type == "object" and (.isSidechain | not))] as $rows
    | ([$rows[] | select(.type == "api-request")] | last | [.cacheControl[]?.value.ttl] | last) // "unknown"
    | "\(.) \([$rows[] | select(.type == "assistant")] | last | .isApiErrorMessage == true)"')" || return 0
  if [[ "$request" != "1h "* ]]; then
    keepalive_decided "$session" "$last" skipped "ttl-${request%% *}" "$idle" "$tokens"
    return 0
  fi
  if [[ "$request" == *" true" ]]; then
    keepalive_decided "$session" "$last" skipped api-error "$idle" "$tokens"
    return 0
  fi
  if ! coordinator_ready; then
    keepalive_waiting "$session" "$last" not-running
    return 0
  fi
  state="$(hc get "$COORDINATOR" --json | jq -r '.status.state // "unknown"')" || state=unknown
  if [[ "$state" != idle && "$state" != "done" ]]; then
    keepalive_waiting "$session" "$last" "$state"
    return 0
  fi
  in_charge || return 0
  if ! screen="$(hc read "$COORDINATOR" --lines 0)" || ! input_box_of "$screen"; then
    keepalive_waiting "$session" "$last" screen
    return 0
  fi
  box="$REPLY"
  if input_box_stashed "$screen"; then
    keepalive_waiting "$session" "$last" stashed
    return 0
  fi
  if ! input_box_is_empty "$box"; then
    if [[ "$box" != "$KEEPALIVE_DRAFT" ]]; then
      KEEPALIVE_DRAFT="$box"
      keepalive_waiting "$session" "$last" draft
      return 0
    fi
    if ! hc keys "$COORDINATOR" ctrl+s >/dev/null; then
      keepalive_waiting "$session" "$last" send-failed
      return 0
    fi
    # 記録に、書きかけを退避したか、候補だったかを残す
    if ! screen="$(hc read "$COORDINATOR" --lines 0)"; then
      reason=ctrl-s
    elif input_box_stashed "$screen"; then
      reason=stash
    else
      reason=suggestion
    fi
  fi
  KEEPALIVE_DRAFT=""
  if ! hc send "$COORDINATOR" "$KEEPALIVE_TEXT" >/dev/null; then
    echo "prompt cache を延ばす入力を coordinator に送れませんでした。次の見張りで送り直します" >&2
    keepalive_waiting "$session" "$last" send-failed
    return 0
  fi
  keepalive_decided "$session" "$last" sent "$reason" "$idle" "$tokens"
}

# coordinator の会話が CACHE_NOTICE_IDLE_MIN 分止まったら、延ばす時間帯なら cache を延ばす（keep_cache_warm）。
# 時間帯の外で context が大きければ、prompt cache が切れる前に知らせて、user に引き継ぎを提案させる。
# 切れた後の最初の入力は会話の全体を書き直すが、引き継げば約 110k から始められる。引き継ぎの progress を書くターンも、
# cache が温かいうちでないと書き直しを払う。知らせのターンで cache は 1 時間延びる。
# 記録を読むのは CACHE_DUE の時刻だけで、それまでの周期はプロセスを起動しない。読んで最後の応答から CACHE_NOTICE_IDLE_MIN 分たって
# いなければ、たつ時刻まで読まない。たっていれば延ばすか知らせるかを決め、次は CACHE_NOTICE_IDLE_MIN 分後に読む（延ばした入力の
# 応答や新しい応答は、そのとき拾う）。延ばせない・送れないときは次の周期で読み直す
check_cache() {
  local session transcript last tokens now weekday hhmm idle state
  coordinator_session_of "$PROJECT_DIR" || return 0
  session="$REPLY"
  # /clear などで会話が変わったら、すぐに読む
  if [[ "$session" != "$CACHE_SESSION" ]]; then
    CACHE_SESSION="$session"
    CACHE_DUE=0
  fi
  ((SECONDS >= CACHE_DUE)) || return 0
  transcript="$(transcript_of "$session")" || return 0
  # 応答がまだ無い（会話を始めた直後）・記録を読めないときは、数分おいて読み直す
  CACHE_DUE=$((SECONDS + 300))
  last="$(last_api_call_epoch "$session")" || return 0
  tokens="$(context_tokens_of "$session")" || return 0
  read -r now weekday hhmm <<<"$(date '+%s %u %H%M')"
  if ((now - last < CACHE_NOTICE_IDLE_MIN * 60)); then
    CACHE_DUE=$((SECONDS + CACHE_NOTICE_IDLE_MIN * 60 - (now - last)))
    return 0
  fi
  CACHE_DUE=$((SECONDS + CACHE_NOTICE_IDLE_MIN * 60))
  idle=$(((now - last) / 60))
  if keepalive_hours; then
    if [[ -n "$REPLY" ]] && keep_cache_warm "$session" "$last" "$idle" "$tokens" "$REPLY" "$weekday" "$hhmm" "$transcript"; then
      return 0
    fi
  else
    echo "prompt cache を延ばす時間帯の設定（${KEEPALIVE_HOURS_FILE}）の書式が違うので、延ばしていません" >&2
    keepalive_decided "$session" "$last" skipped setting "$idle" "$tokens"
  fi
  ((idle >= CACHE_NOTICE_IDLE_MIN && idle < CACHE_NOTICE_LATEST_MIN)) || return 0
  handoff_proposal_due "$PROJECT_DIR" "$session" "$tokens" "$CACHE_NOTICE_MIN_TOKENS" || return 0

  # 作業中・許可待ちの coordinator には送らない。次の周期で見直す
  CACHE_DUE=0
  coordinator_ready || return 0
  state="$(hc get "$COORDINATOR" --json | jq -r '.status.state // empty')" || return 0
  [[ "$state" == idle || "$state" == "done" ]] || return 0
  in_charge || return 0
  if ! send_keeping_draft "$COORDINATOR" "[project-threads cache] coordinator の最後の応答から ${idle} 分たち、context は $(format_tokens "$tokens") です。あと数分で prompt cache が切れ、次の入力で会話の全体を書き直します。user に次の 1 行だけを返し、ほかの作業はしないでください: $(handoff_proposal_line "$tokens")" >/dev/null; then
    echo "引き継ぎの提案の知らせを coordinator に送れませんでした。次の見張りで送り直します" >&2
    return 0
  fi
  CACHE_DUE=$((SECONDS + CACHE_NOTICE_IDLE_MIN * 60))
  mark_handoff_proposed "$PROJECT_DIR" "$session" "$tokens"
}

# PR_INTERVAL ごとに thread の PR を見て、変化を coordinator に知らせる（bin/pr-watch）。別のスクリプトにするのは、常駐の見張りは
# 起動したときのコードで動き続けるが、呼ぶたびに読み込むスクリプトなら bin/ を直した後の呼び出しから新しいコードで動くため
check_prs() {
  ((SECONDS >= PR_DUE)) || return 0
  PR_DUE=$((SECONDS + PR_INTERVAL))
  in_charge || return 0
  "$MOD_DIR/bin/pr-watch" "$PROJECT_DIR" || echo "thread の PR を見られませんでした（${PR_INTERVAL} 秒後に見直します）" >&2
}

# terminal の題名を出す。名前の無い hc の子は、一覧（my-agents）で題名か program 名で出るので、題名が無いと「bash」になり、
# 何の子か分からない。行頭の `<project>/` は、親の coordinator の行（`project:<project>`）の下では一覧が落とす
printf '\e]0;%s/見張り 報告の遅れを知らせる\a' "${PROJECT_DIR##*/}"

replace_previous_watch
while in_charge; do
  check_overdue
  check_stalled
  check_cache
  check_prs
  [[ "$ONCE" != "--once" ]] || exit 0
  sleep "$INTERVAL"
done
