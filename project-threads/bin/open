#!/usr/bin/env bash
# project を開く: 無ければ <repo>/.local/hc-projects/<name>/ を作り、右に thread の一覧の pane を開いて、
# この terminal で coordinator の claude を起動する。herdr-app の terminal の中で実行する。
#
# usage: open <name> [--new]
#   --new  前回の coordinator の会話を引き継がず、新しい会話で開く
# shellcheck disable=SC1010  # herdr-app の do はサブコマンドで、シェルの do ではない
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 || ! "$1" =~ ^[a-z0-9][a-z0-9-]*$ || ( $# -eq 2 && "$2" != "--new" ) ]]; then
  echo "usage: $0 <name> [--new]  (name は小文字英数字とハイフン)" >&2
  exit 1
fi
NAME="$1"
FRESH="${2:-}"

# thread の報告は hc でこの terminal に届く。hc の外では届け先が無い
if [[ -z "${HC_TERMINAL_ID:-}" ]]; then
  echo "herdr-app の terminal の中で実行してください（HC_TERMINAL_ID がありません）" >&2
  exit 1
fi

MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"
REPO_ROOT="$(git rev-parse --show-toplevel)"
PROJECT_DIR="$REPO_ROOT/.local/hc-projects/$NAME"

# coordinator の skill の一覧で説明を残す skill を 1 行に 1 つ書いたファイル（user が手で書く）。載せていない skill は名前だけに
# する。coordinator は調べる作業を thread に任せ、説明を見て skill を選ぶことがほぼ無いのに、一覧の説明が毎回の入力に載る。
# user が打つ /<名前> と、名前を指定した Skill ツールの呼び出し（hook が起動させる session-goal など）は名前だけでも動く。
# thread 用の一覧（THREAD_SKILLS）とは分ける。thread 用は repo の skill の説明を残すので、共有すると coordinator の一覧がほぼ
# 減らない。project のフォルダを作る前に組み立てる（読めなければ何も作らずに止める）。まだ無いフォルダからも git の最上位まで
# たどって repo の skill を集められる。XDG_CONFIG_HOME を見るのは、テストに手元のファイルを読ませないため
COORDINATOR_SKILLS="${XDG_CONFIG_HOME:-$HOME/.config}/project-threads/coordinator-skills.txt"
if [[ ! -e "$COORDINATOR_SKILLS" ]]; then
  if ! { mkdir -p "${COORDINATOR_SKILLS%/*}" && cp "$MOD_DIR/templates/coordinator-skills.txt" "$COORDINATOR_SKILLS"; }; then
    echo "coordinator の skill の一覧で説明を残す skill のファイル（${COORDINATOR_SKILLS}）を雛形から作れないので、coordinator を起動していません。作れない理由を直してから、open をもう一度実行してください。" >&2
    exit 1
  fi
  echo "coordinator の skill の一覧で説明を残す skill のファイルが無かったので、雛形から ${COORDINATOR_SKILLS} を作りました（載せていない skill は名前だけになります。説明を残す skill を足したら、open <name> --new で開き直した会話から効きます）。" >&2
fi
SKILL_SETTINGS="$(with_kept_skills '{}' "$COORDINATOR_SKILLS" "$PROJECT_DIR" "coordinator の skill の一覧" \
  "coordinator を起動していません。読めないファイルを直してから、open をもう一度実行してください。")"

CREATED=false
if [[ ! -d "$PROJECT_DIR" ]]; then
  mkdir -p "$PROJECT_DIR/memory" "$PROJECT_DIR/threads" "$PROJECT_DIR/drafts"
  template="$(cat "$MOD_DIR/templates/CLAUDE.md")"
  printf '%s\n' "${template//\{\{name\}\}/$NAME}" > "$PROJECT_DIR/CLAUDE.md"
  cp "$MOD_DIR/templates/MEMORY.md" "$PROJECT_DIR/memory/MEMORY.md"
  # repo 固有の決まりの雛形（coordinator 用と thread 用）。その repo のほかの project と共有するので、既にあれば触らない
  for rules in repo-coordinator-rules.md repo-thread-rules.md; do
    if [[ ! -e "$REPO_ROOT/.local/hc-projects/$rules" ]]; then
      cp "$MOD_DIR/templates/$rules" "$REPO_ROOT/.local/hc-projects/$rules"
    fi
  done
  # 新しい project の thread は claude.ai の connector を切って始める（使う作業が出たら bin/connectors で on にする）。
  # 使わない会話でも、遅延ツールの名前の一覧と MCP の指示が thread と subagent の毎回の入力に載る。
  # 欄の無い既存の project は読み込むまま（開き直しでもこの欄には触れない）
  jq -n --arg name "$NAME" '{name: $name, coordinator: {}, threadConnectors: false}' > "$PROJECT_DIR/project.json"
  CREATED=true
  echo "project を作成: $PROJECT_DIR" >&2
fi

render_prompt "$MOD_DIR/prompts/coordinator.md" "$PROJECT_DIR/coordinator-prompt.md" "$MOD_DIR/bin" "$PROJECT_DIR"

# /pj-threads:* の command（引き継ぎ・umbrella・回送の手順）は本文に {bin}・{project} の絶対パスを持つので、project ごとに展開した
# plugin を渡す。Claude Code が command の本文で置き換えるのは ${CLAUDE_PLUGIN_ROOT} などだけで、そこから組んだパスは
# 許可の Bash(<bin>/handoff *) に前方一致しない。雛形は prompts/commands/ に置き、開き直す前の coordinator が起動時に
# 読み込んだ plugin/ とは分ける。中身が変わらなければ置き換えない（right-sidebar の Docs タブは .local の Markdown を
# 更新の新しい順に並べるので、開くたびに command が上に出ないように）。雛形を消したときに古い展開が残らないよう、丸ごと作り直して比べる
PLUGIN_DIR="$PROJECT_DIR/coordinator-plugin"
NEW_PLUGIN_DIR="$(mktemp -d "$PROJECT_DIR/.coordinator-plugin.XXXXXX")"
mkdir -p "$NEW_PLUGIN_DIR/.claude-plugin" "$NEW_PLUGIN_DIR/commands"
cp "$MOD_DIR/plugin/.claude-plugin/plugin.json" "$NEW_PLUGIN_DIR/.claude-plugin/plugin.json"
for template in "$MOD_DIR/prompts/commands"/*.md; do
  render_prompt "$template" "$NEW_PLUGIN_DIR/commands/${template##*/}" "$MOD_DIR/bin" "$PROJECT_DIR"
done
if diff -rq "$NEW_PLUGIN_DIR" "$PLUGIN_DIR" >/dev/null 2>&1; then
  rm -rf "$NEW_PLUGIN_DIR"
else
  rm -rf "$PLUGIN_DIR"
  mv "$NEW_PLUGIN_DIR" "$PLUGIN_DIR"
fi

# 前回開いたときの一覧の pane が残っていると 2 枚になるので、先に閉じる。もう無い pane なら失敗するが、それでよい
OLD_PANE="$(jq -r '.listPane // empty' "$PROJECT_DIR/project.json")"
if [[ -n "$OLD_PANE" ]]; then
  herdr-app do pane.close --pane "$OLD_PANE" >/dev/null 2>&1 || true
fi

# 一覧はこの terminal の pane の右に開く。pane が分からなくても project は開く（一覧が出ないだけ）ので、理由を出して進む
LIST_PANE=""
if OWN_PANE="$(herdr-app ls | jq -er --arg t "$HC_TERMINAL_ID" 'first(.spaces[].tabs[].terminals[] | select(.terminal == $t) | .pane)')"; then
  LIST_PANE="$(herdr-app do pane.split --direction right --pane "$OWN_PANE" --mod project-threads \
    --props "$(jq -nc --arg project "$PROJECT_DIR" '{project: $project}')" | jq -er '.pane')"
  # 分割は新しい pane にフォーカスを移すので、claude を起動するこの pane に戻す
  herdr-app do pane.focus --pane "$OWN_PANE" >/dev/null
else
  echo "この terminal の pane が herdr-app ls に見つからないので、thread の一覧は開きません" >&2
fi

# coordinator.bin は、この coordinator が使う bin/ のフォルダ。一覧（mod の写しで動く）は回答欄の答えをここの answer で送る。
# coordinator の prompt と同じ bin/ を使わせ、bin/ の直しを main に入れた時点で効かせる（写しの bin/ は置き直すまで古い）
recorded="$(jq --arg terminal "$HC_TERMINAL_ID" --arg pane "$LIST_PANE" --arg bin "$MOD_DIR/bin" \
  '.coordinator.terminal = $terminal | .coordinator.bin = $bin | if $pane == "" then del(.listPane) else .listPane = $pane end' "$PROJECT_DIR/project.json")"
printf '%s\n' "$recorded" > "$PROJECT_DIR/project.json"

# cleanup は auto mode の判定に「取り消せない削除」として拒否される（一覧を出すだけの呼び出しも）ので許可に入れる。
# 消す前に user の承認を取ることは prompt で決めている。
# SessionStart hook は coordinator の会話の id を project の coordinator-session に書く。見張りと report が coordinator の会話の
# 記録から context と最後の応答の時刻を取り、引き継ぎを提案させるのに使う。/clear で会話の id が変わるので、起動・再開・/clear の
# たびに動く SessionStart で書く。hook の stdout は会話に入るので出さない。パスは単一引用符で囲む（worktree のパスなどに = が入る）
# bash 3.2 は二重引用符の中の置き換えで \ を残すので、引用符の外で置き換える
# disableClaudeAiConnectors: coordinator は claude.ai の connector（Slack・Datadog・Claude Docs など）を使わない（thread に
# 任せる）のに、MCP の指示とツールの名前が毎回の入力に載る。thread は使う project があるので、thread の起動では
# project の設定（threadConnectors。上で新しく作る project は false）で切ったときだけ切る
QUOTED_DIR=${PROJECT_DIR//\'/\'\\\'\'}
SESSION_FILE="'$QUOTED_DIR/coordinator-session'"
SETTINGS="$(jq -nc --arg start "Bash($MOD_DIR/bin/start *)" --arg message "Bash($MOD_DIR/bin/message *)" \
  --arg relay "Bash($MOD_DIR/bin/relay *)" --arg relayReceived "Bash($MOD_DIR/bin/relay-received *)" \
  --arg projects "Bash($MOD_DIR/bin/projects *)" --arg describe "Bash($MOD_DIR/bin/describe *)" \
  --arg cleanup "Bash($MOD_DIR/bin/cleanup *)" --arg connectors "Bash($MOD_DIR/bin/connectors *)" \
  --arg handoff "Bash($MOD_DIR/bin/handoff *)" --arg umbrella "Bash($MOD_DIR/bin/umbrella *)" \
  --arg nextActions "Bash($MOD_DIR/bin/next-actions *)" --arg closeQuestion "Bash($MOD_DIR/bin/close-question *)" \
  --arg threadCount "Bash($MOD_DIR/bin/thread-count *)" --arg memory "Bash($MOD_DIR/bin/memory *)" \
  --arg ask "Bash($MOD_DIR/bin/ask *)" \
  --arg session "jq -r .session_id > $SESSION_FILE.tmp && mv $SESSION_FILE.tmp $SESSION_FILE" \
  --argjson skills "$SKILL_SETTINGS" \
  --arg otel "$(otel_resource_attributes "$PROJECT_DIR" hc.role=coordinator)" \
  '{permissions: {allow: [$start, $message, $relay, $relayReceived, $projects, $describe, $cleanup, $handoff, $umbrella, $nextActions, $closeQuestion, $ask, $connectors, $threadCount, $memory]},
    hooks: {SessionStart: [{hooks: [{type: "command", command: $session}]}]},
    disableClaudeAiConnectors: true, env: {OTEL_RESOURCE_ATTRIBUTES: $otel}} + $skills')"
# model と effort は --continue で開き直すときも渡す。claude は --continue で model は引き継ぐが effort は引き継がない
# （渡さないと既定に戻る）。渡せば前の会話の値より優先される
ARGS=(
  --permission-mode auto
  --model opus
  --effort high
  # Agent: coordinator は subagent を起動しない（調べる作業は thread に任せる）のに、ツールの定義と agent の一覧が毎回の
  # 入力に載る。thread は使うので、UNUSED_TOOLS には入れない
  --disallowedTools "$UNUSED_TOOLS,Agent"
  # coordinator はブラウザを操作しない（thread に任せる）のに、Claude in Chrome の指示とツールの名前が毎回の入力に載る
  --no-chrome
  # coordinator は MCP のツールを使わない（調べる作業は thread に任せる）のに、MCP の指示と遅延ツールの名前が毎回の入力に載る。
  # 作業フォルダ（repo の .local/hc-projects/<name>）から上へたどって repo の .mcp.json が読まれる（zumen-engine の Datadog・
  # Terraform）。--strict-mcp-config は --mcp-config で渡したもののほかの MCP を読まない（user・project・plugin の MCP とも）。
  # thread の起動は coordinator の引数を受け継がないので、thread はこれまでどおり読む
  --strict-mcp-config
  --name "project:$NAME"
  --append-system-prompt-file "$PROJECT_DIR/coordinator-prompt.md"
  --settings "$SETTINGS"
  # /pj-threads:clear・/pj-threads:exit・/pj-threads:umbrella・/pj-threads:relay・/pj-threads:merged・/pj-threads:dashboard-thread-count の
  # command だけの plugin（上で展開した）。
  # 言葉で頼まれたときと回送が届いたときは、coordinator が Skill ツールで同じ本文を読み込む
  --plugin-dir "$PLUGIN_DIR"
  # Artifact を遅延ロードにする Claude Code の plugin（thread と共有する）
  --plugin-dir "$MOD_DIR/defer-artifact"
)
# project のフォルダを作業フォルダにするのは coordinator だけなので、--continue が拾うのは前回の coordinator の会話。
# /clear の後に開き直しても、/clear より後の会話を拾う
if [[ "$CREATED" == false && "$FRESH" != "--new" ]]; then
  ARGS+=(--continue)
fi

# 報告の遅れの見張りを、この terminal の子として起動し、このプロセスの PID を渡す。下で claude を exec するので、
# この PID が coordinator の claude になり、見張りはそれが終わったら終わる。hc の子が親と一緒に終わるのは、この terminal の
# program（open を打ったシェル）が終わったときなので、hc には任せられない（claude が終わってもシェルが残る）。
# 前に開いたときの見張りが残っていれば、新しい見張りが止める。
# 起動できなくても coordinator は開く（遅れを知らせないだけ）ので、理由を出して進む
if ! hc run --bg --json --no-notify --cwd "$PROJECT_DIR" -- "$MOD_DIR/bin/watch" "$PROJECT_DIR" "$$" >/dev/null; then
  echo "報告の遅れの見張りを起動できないので、waiting の見込みを過ぎても coordinator に知らせません" >&2
fi

# claude は全画面で描くので、終わると会話の表示ごと消え、claude が出す「claude --resume <id>」だけが残る（再開すると
# 元の prompt のまま続く）。起動の前に出した行は終わった後の画面に残るので、/pj-threads:exit で終えた後の開き直し方をここで出す
echo "coordinator を終えた後に新しい会話で開き直すときは $(reopen_command "$NAME") を打つ（--new を外すと前の会話の続き）" >&2
cd "$PROJECT_DIR"
exec claude "${ARGS[@]}"
