#!/usr/bin/env bash
# coordinator の会話を引き継ぐ: coordinator が memory/progress.md に進行状況を書いた後に呼ぶ。補助を起動してすぐ戻り、
# 補助が coordinator のターンの終わりを待って /clear を打ち、続けて progress を読んで続きに入るよう入力を送る。
#
# coordinator の claude は slash command を自分では打てない。また、ターンの最中に /clear を打つとキューに入り、
# キューで後ろに続いた入力は /clear と一緒に消える。だから、ターンが終わってから外の補助が打つ。
# 補助は、ターンの終わりを待つ間に終わった thread を片付け（cleanup --handoff）、結果を最初の入力に添える。
# memory の索引が大きくなっていれば、整理の候補を洗い出す thread も起動する（start_memory_tidy）。
#
# usage: handoff <project のフォルダ>
#        handoff --check-index <project のフォルダ>   （memory の索引の長すぎる要約を数える。開き直す前の coordinator が呼ぶ）
#        handoff --after-turn <project のフォルダ> <coordinator の terminal>   （補助。handoff が自分で起動する）
set -euo pipefail

# progress がこれより古ければ、今回の引き継ぎで書いたものではないとみなし、clear しない
PROGRESS_MAX_AGE_MIN=10
# ターンが終わるのを待つ上限。過ぎたら clear せず、coordinator に知らせる
WAIT_LIMIT_SEC=1800
# /clear の後に送る最初の入力。補助は HC_TERMINAL_ID を外して送るので、<hc> の目印は付かない
RESUME_TEXT='[project-threads handoff] 会話を /clear しました。prompt の「会話を始めるとき」の手順どおり、project memory の索引と progress、threads/*/status.json を読み、引き継いだ状況（動いている thread と次にやること）と、user に判断を仰ぐ件を短く伝えてください。伝えるだけにして、thread への送信や起動などの操作は user の返事を待ってから行ってください'
# memory の整理の候補を洗い出す thread を起動する目安。前の整理（_lib.sh の MEMORY_TIDIED_FILE）から索引の行がこれだけ増えたか、
# 要約が上限を超える行があれば起動する。終わった件の memory は索引の行数を見ないと溜まり続け（v7-search で外す候補 49 件）、
# 毎回起動すると引き継ぎのたびに thread 1 本の費用がかかるので、その間を取った（user が決めた。数字は様子を見て変える）
MEMORY_TIDY_GROWTH=10
# 整理の thread の題名。終わっていない整理の thread を見分けるのにも使う
MEMORY_TIDY_TITLE="memory の整理候補の洗い出し"

usage() {
  echo "usage: $0 <project のフォルダ>" >&2
  exit 1
}

MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"

# 補助: 終わった thread を片付けながら coordinator のターンが終わるのを待ち、/clear と最初の入力を送る
after_turn() { # <project のフォルダ> <coordinator の terminal>
  local coordinator="$2" prompt="$1/coordinator-prompt.md" deadline state
  # hc の terminal の中から送ると、本文が <hc from="..."> で囲まれて slash command にならない
  unset HC_TERMINAL_ID
  # 片付けは haiku の要約で 1 本十数秒かかるので、ターンの終わりを待つ間に回す。user が引き継ぎを頼んだことを承認とみなす（user が決めた）
  CLEANUP_OUT="$(mktemp)"
  "$MOD_DIR/bin/cleanup" "$1" --handoff > "$CLEANUP_OUT" 2>&1 &
  CLEANUP_PID=$!
  deadline=$((SECONDS + WAIT_LIMIT_SEC))
  while true; do
    # user が coordinator を終わらせていたら、残ったシェルに打ち込まないよう何もせずに終わる。片付けは終わるまで待つ（途中で止めない）
    is_claude_with "$coordinator" "$prompt" || { cleanup_note; exit 0; }
    hc wait "$coordinator" --timeout 600 >/dev/null 2>&1 || true
    state="$(hc get "$coordinator" --json | jq -r '.status.state // empty')"
    # ターンが終わった直後は done のことも idle のこともある
    if [[ "$state" == idle || "$state" == "done" ]]; then
      break
    fi
    if ((SECONDS >= deadline)); then
      cleanup_note
      send_keeping_draft "$coordinator" "[project-threads handoff] /clear を打てませんでした（$((WAIT_LIMIT_SEC / 60)) 分待ってもターンが終わらない。status: ${state:-不明}）。progress は残っているので、user に /clear を打ってもらってください。$REPLY" >/dev/null || true
      exit 1
    fi
    # 許可の確認などで止まっている間、hc wait はすぐ戻るので間を置く
    if [[ "$state" != working ]]; then
      sleep 5
    fi
  done
  is_claude_with "$coordinator" "$prompt" || { cleanup_note; exit 0; }
  # --wait で /clear が済むのを待ってから送る。済む前に送ると、キューに入って /clear と一緒に消える
  if ! send_keeping_draft --wait --timeout 60 "$coordinator" /clear >/dev/null; then
    cleanup_note
    send_keeping_draft "$coordinator" "[project-threads handoff] /clear を打てませんでした（hc send が失敗）。progress は残っているので、user に /clear を打ってもらってください。$REPLY" >/dev/null || true
    exit 1
  fi
  memory_tidy_note "$1"
  local memory="$REPLY"
  # 最初の入力は片付けが終わってから送る。後から別の入力で送ると、/clear の後の会話の返答の途中に割り込む
  cleanup_note
  send_keeping_draft "$coordinator" "$RESUME_TEXT$memory"$'\n'"$REPLY" >/dev/null
}

# after_turn が裏で回した片付けが終わるのを待ち、結果を最初の入力に添える形で REPLY に入れる
cleanup_note() {
  local rc=0 out=""
  wait "$CLEANUP_PID" || rc=$?
  IFS= read -rd '' out < "$CLEANUP_OUT" || true
  rm -f "$CLEANUP_OUT"
  out="${out%$'\n'}"
  if [[ "$rc" -eq 0 ]]; then
    REPLY="引き継ぎのときに handoff が終わった thread を片付けました（user が引き継ぎを頼んだことを承認とみなす決まり）。user には片付けた件数を 1 行で伝えてください:"$'\n'"$out"
  else
    REPLY="引き継ぎのときの終わった thread の片付けで失敗がありました（cleanup が exit ${rc}）。下の出力のとおり、片付けたものと失敗を user に 1 行で伝えてください。片付けていない thread は threads/ に残っています:"$'\n'"${out:0:2000}"
  fi
}

# 終わっていない（報告が無いか done でない）memory の整理の thread があれば、その id を REPLY に入れる。無ければ失敗
unfinished_memory_tidy() { # <project のフォルダ>
  local f status
  REPLY=""
  for f in "$1"/threads/*/thread.json; do
    [[ -f "$f" && "$(jq -r '.title // empty' "$f")" == "$MEMORY_TIDY_TITLE" ]] || continue
    status=""
    if [[ -f "${f%/thread.json}/status.json" ]]; then status="$(jq -r '.status // empty' "${f%/thread.json}/status.json")"; fi
    if [[ "$status" != "done" ]]; then
      REPLY="${f%/thread.json}"
      REPLY="${REPLY##*/}"
      return 0
    fi
  done
  return 1
}

# /clear の後の最初の入力に添える、memory の整理の知らせを REPLY に入れる（無ければ空）。整理の thread は報告するまで
# status.json が無く、/clear の後の会話が「会話を始めるとき」に読む物からは見えない
memory_tidy_note() { # <project のフォルダ>
  if [[ -e "$1/$MEMORY_CANDIDATES_FILE" ]]; then
    REPLY=" memory の整理候補が user の答えを待っています。\`$MOD_DIR/bin/memory $1 check\` の出力のとおり、件数を示して判断を仰いでください"
  elif unfinished_memory_tidy "$1"; then
    REPLY=" 引き継ぎのときに handoff が、memory の整理候補を洗い出す thread ${REPLY} を起動しました（user の承認は取らずに起動する決まり）。動いている thread と一緒に伝えてください"
  else
    REPLY=""
  fi
}

# memory の索引が前の整理から MEMORY_TIDY_GROWTH 行以上増えたか、要約が上限を超える行があれば、整理の候補を洗い出す thread（sonnet）を
# 起動する。洗い出しは memory の本文と issue・PR の状態を読むので、coordinator の会話の外で行う。user が引き継ぎを頼んだことを
# 起動の承認とみなす（user が決めた）。候補が user の答えを待っている間と、前の整理の thread が終わっていない間は起動しない
start_memory_tidy() { # <project のフォルダ>
  local project="$1" index="$1/memory/MEMORY.md" entries long tidied="" brief out
  [[ -f "$index" && ! -e "$project/$MEMORY_CANDIDATES_FILE" ]] || return 0
  if unfinished_memory_tidy "$project"; then return 0; fi
  read -r entries long < <(jq -Rnr --argjson max "$SUMMARY_MAX_CHARS" "$MEMORY_INDEX_JQ"'
    [inputs | entry] | "\(length) \(map(select((.rest | summary_of | length) > $max)) | length)"' "$index")
  if [[ -f "$project/$MEMORY_TIDIED_FILE" ]]; then read -r tidied < "$project/$MEMORY_TIDIED_FILE" || true; fi
  # 記録が無ければ、まだ一度も整理していないので 0 行から数える
  [[ "$tidied" =~ ^[0-9]+$ ]] || tidied=0
  if ((entries - tidied < MEMORY_TIDY_GROWTH && long == 0)); then return 0; fi
  brief="$(mktemp)"
  render_prompt "$MOD_DIR/prompts/memory-tidy-brief.md" "$brief" "$MOD_DIR/bin" "$project"
  # start の警告と失敗の理由（stderr）は、そのまま coordinator に見せる
  if out="$("$MOD_DIR/bin/start" "$project" "$MEMORY_TIDY_TITLE" "$brief" --model sonnet)"; then
    rm "$brief"
    printf '%s\n' "$entries" > "$project/$MEMORY_TIDIED_FILE"
    out="${out#*THREAD_ID=}"
    echo "memory の索引が前の整理から $((entries - tidied)) 行増え、要約が ${SUMMARY_MAX_CHARS} 文字を超える行が ${long} 行あるので、整理の候補を洗い出す thread ${out%%$'\n'*} を起動しました（/clear の後の会話に知らせます）"
  else
    rm "$brief"
    echo "memory の整理の候補を洗い出す thread を起動できませんでしたが、引き継ぎは続けます。上の理由の判断は仰がずに、起動できなかったことを user に 1 行で伝えてからターンを終えてください（次の引き継ぎでまた起動します）"
  fi
}

# memory の索引のうち、要約が上限を超える行を数えて出す。超えていても失敗にはしない。
# 呼ぶのは、整理の thread ができる前の手順（progress の「memory の整理候補」に coordinator が書く）で動いている、
# 開き直す前の coordinator だけ。全 project の coordinator を open --new で開き直したら消す
check_index() { # <project のフォルダ>
  local index="$1/memory/MEMORY.md"
  if [[ ! -f "$index" ]]; then
    echo "$index がありません" >&2
    exit 1
  fi
  jq -Rnr --argjson max "$SUMMARY_MAX_CHARS" "$MEMORY_INDEX_JQ"'
    [inputs | entry | {link, chars: (.rest | summary_of | length)} | select(.chars > $max)] as $long
    | if ($long | length) == 0 then
        "memory の索引に、要約が \($max) 文字を超える行はありません"
      else
        "memory の索引に、要約が \($max) 文字を超える行が \($long | length) 件あります。progress の「memory の整理候補」に、直した要約の案を添えて書いてください:",
        ($long[] | "- \(.link)（\(.chars) 文字）")
      end' "$index"
}

if [[ "${1:-}" == "--check-index" ]]; then
  [[ $# -eq 2 && -f "$2/project.json" ]] || usage
  check_index "$(cd "$2" && pwd)"
  exit 0
fi

if [[ "${1:-}" == "--after-turn" ]]; then
  [[ $# -eq 3 && -f "$2/project.json" ]] || usage
  after_turn "$(cd "$2" && pwd)" "$3"
  exit 0
fi

[[ $# -eq 1 && -f "$1/project.json" ]] || usage
PROJECT_DIR="$(cd "$1" && pwd)"

if [[ -z "${HC_TERMINAL_ID:-}" ]]; then
  echo "hc の terminal の中で実行してください（HC_TERMINAL_ID がありません）" >&2
  exit 1
fi
if [[ "$(jq -r '.coordinator.terminal // empty' "$PROJECT_DIR/project.json")" != "$HC_TERMINAL_ID" ]]; then
  echo "この terminal ($HC_TERMINAL_ID) はこの project の coordinator ではありません" >&2
  exit 1
fi
PROGRESS="$PROJECT_DIR/memory/progress.md"
if [[ ! -f "$PROGRESS" ]]; then
  echo "$PROGRESS がありません。進行状況を書いてから呼んでください（clear はしていません）" >&2
  exit 1
fi
if [[ -z "$(find "$PROGRESS" -mmin "-$PROGRESS_MAX_AGE_MIN")" ]]; then
  echo "$PROGRESS が $PROGRESS_MAX_AGE_MIN 分より前に書かれたままです。今回の進行状況を書き直してから呼んでください（clear はしていません）" >&2
  exit 1
fi

# 補助はこの terminal の子にする。coordinator の terminal が終われば一緒に終わる。
# --rm: 終わったら消す。--no-notify: 終了の知らせを coordinator の入力に入れない（clear の後の会話に混ざる）
hc run --bg --rm --no-notify --json --cwd "$PROJECT_DIR" -- "$MOD_DIR/bin/handoff" --after-turn "$PROJECT_DIR" "$HC_TERMINAL_ID" >/dev/null
echo "このターンが終わったら会話を /clear し、続けて progress を読むよう入力を送ります。ほかの作業を始めずにターンを終えてください。/clear までに thread の報告が届いたら、「引き継ぎ中なので /clear の後に扱います」とだけ返してください（報告は status.json に残り、/clear の後の会話が拾います）"
# 補助を起動した後に行う。整理の thread を起動できなくても、引き継ぎは止めない。補助は coordinator のターンが終わるのを待つので、
# 起動を待つ間（長くて 60 秒）に /clear されることはない
start_memory_tidy "$PROJECT_DIR"
