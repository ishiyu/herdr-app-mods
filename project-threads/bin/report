#!/usr/bin/env bash
# thread が作業の区切りを報告する: status.json と、詳細の写し（reports/<時刻>-<status>.md）に残し、
# terminal のラベルを更新して、coordinator に知らせる。thread が呼ぶ。
#
# usage: report <done|blocked|needs-you|waiting> <要約> [--within <分>] [--detail-file <Markdown のファイル>]
#   --within  waiting のときだけ必須。完了見込みまでの分数。過ぎても次の報告が無いと、watch が coordinator に知らせる
set -euo pipefail

usage() {
  echo "usage: $0 <done|blocked|needs-you|waiting> <要約> [--within <分>] [--detail-file <Markdown のファイル>]" >&2
  echo "  --within は waiting のときだけ必須（完了見込みまでの分数）" >&2
  exit 1
}

[[ $# -ge 2 ]] || usage
STATUS="$1"
SUMMARY="$2"
shift 2
DETAIL_FILE=""
WITHIN=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --detail-file) [[ $# -ge 2 ]] || usage; DETAIL_FILE="$2"; shift 2 ;;
    --within) [[ $# -ge 2 ]] || usage; WITHIN="$2"; shift 2 ;;
    *) usage ;;
  esac
done
case "$STATUS" in
  done | blocked | needs-you | waiting) ;;
  *) usage ;;
esac
[[ -n "$SUMMARY" ]] || usage
# 見込みは waiting にだけ付け、waiting には必ず付ける。既定の時間で補うと、thread の見込みと無関係な時刻で知らせることになる
if [[ "$STATUS" == "waiting" ]]; then
  [[ "$WITHIN" =~ ^[1-9][0-9]*$ ]] || usage
elif [[ -n "$WITHIN" ]]; then
  usage
fi
if [[ -n "$DETAIL_FILE" && ! -f "$DETAIL_FILE" ]]; then
  echo "detail のファイルがありません: $DETAIL_FILE" >&2
  exit 1
fi

if [[ -z "${HC_TERMINAL_ID:-}" ]]; then
  echo "hc の terminal の中で実行してください（HC_TERMINAL_ID がありません）" >&2
  exit 1
fi

MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"

# thread のフォルダは terminal の起動フォルダから決める。シェルの作業フォルダは thread が移動していることがある
DIR="$(hc get "$HC_TERMINAL_ID" --json | jq -er '.cwd')"
if [[ ! -f "$DIR/thread.json" || "$(basename "$(dirname "$DIR")")" != "threads" ]]; then
  echo "この terminal は thread ではありません（$DIR に thread.json が無い）" >&2
  exit 1
fi
THREAD_ID="$(basename "$DIR")"
PROJECT_DIR="$(dirname "$(dirname "$DIR")")"

NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# 詳細は報告ごとに別のファイルへ写し、渡されたファイルにも前の報告の写しにも書かない。
# report.md に写すと、ほかのファイルで報告したときに report.md に積み上げた前の報告が消える（pc-slow の t001）。
# report.md そのものを渡されても写すのは、thread が次の報告で report.md を書き直しても、この報告の内容を残すため
DETAIL=""
if [[ -n "$DETAIL_FILE" ]]; then
  mkdir -p "$DIR/reports"
  DETAIL="$DIR/reports/${NOW//[-:]/}-$STATUS.md"
  # 同じ秒に 2 回報告しても前の写しを上書きしない
  i=2
  while [[ -e "$DETAIL" ]]; do
    DETAIL="$DIR/reports/${NOW//[-:]/}-$STATUS-$i.md"
    i=$((i + 1))
  done
  cp "$DETAIL_FILE" "$DETAIL"
fi
EXPECTED_AT=""
if [[ -n "$WITHIN" ]]; then
  EXPECTED_AT="$(jq -nr --argjson now "$(date +%s)" --argjson within "$WITHIN" '$now + $within * 60 | todate')"
fi
# 一覧の mod が書きかけを読まないよう、書き終えてから置き換える
jq -n --arg status "$STATUS" --arg summary "$SUMMARY" --arg at "$NOW" --arg expectedAt "$EXPECTED_AT" --arg detail "$DETAIL" \
  '{status: $status, summary: $summary, at: $at}
    + (if $expectedAt == "" then {} else {expectedAt: $expectedAt} end)
    + (if $detail == "" then {} else {detail: $detail} end)' \
  > "$DIR/status.json.tmp"
mv "$DIR/status.json.tmp" "$DIR/status.json"
# 一覧の mod はラベルの変化で描き直す。同じ status を続けて報告しても変化になるよう、時刻も付ける
hc label "$HC_TERMINAL_ID" "report=$STATUS" "report.at=$NOW" >/dev/null

NOTES=""
if [[ -n "$EXPECTED_AT" ]]; then
  NOTES="完了見込み: $(jq -nr --arg t "$EXPECTED_AT" '$t | fromdateiso8601 | strflocaltime("%H:%M")')"
fi
# 詳細を渡さなかった報告には詳細を付けない。前の報告の詳細を指すと、この報告の内容と取り違える
if [[ -n "$DETAIL" ]]; then
  NOTES="${NOTES:+${NOTES}、}詳細: $DETAIL"
fi
LINE="[thread $THREAD_ID $STATUS] $SUMMARY${NOTES:+ ($NOTES)}"
COORDINATOR="$(jq -r '.coordinator.terminal // empty' "$PROJECT_DIR/project.json")"
if [[ -n "$COORDINATOR" ]] && is_claude_with "$COORDINATOR" "$PROJECT_DIR/coordinator-prompt.md"; then
  hc send "$COORDINATOR" "$LINE" >/dev/null
  echo "報告を記録し、coordinator ($COORDINATOR) に送りました"
else
  # coordinator は次に開いたときに status.json を読む
  echo "報告を記録しました。coordinator が動いていないので送っていません"
fi
