#!/usr/bin/env bash
# thread が作業の区切りを報告する: status.json と、詳細の写し（reports/<時刻>-<status>.md）に残し、
# terminal のラベルを更新して、coordinator に知らせる。thread が呼ぶ。
#
# usage: report <done|blocked|needs-you|waiting> <要約> [--within <分>] [--detail-file <Markdown のファイル>]
#   --within  waiting のときだけ必須。完了見込みまでの分数。過ぎても次の報告が無いと、watch が coordinator に知らせる
#   --detail-file  done のときは必須。見出し「確かめた根拠」「前提との食い違い」の欄が要る
set -euo pipefail

# waiting でない報告（作業の区切り）を coordinator に送るとき、coordinator の context がこれ以上なら、報告を伝えた後に引き継ぎを
# 提案させる添え書きを付ける。同じ会話で提案を重ねない決まりは、見張り（bin/watch）の知らせと共有する（_lib.sh の handoff_proposal_due）
HANDOFF_PROPOSE_MIN_TOKENS=200000

usage() {
  echo "usage: $0 <done|blocked|needs-you|waiting> <要約> [--within <分>] [--detail-file <Markdown のファイル>]" >&2
  echo "  --within は waiting のときだけ必須（完了見込みまでの分数）" >&2
  echo "  --detail-file は done のときは必須（見出し「確かめた根拠」「前提との食い違い」の欄が要る）" >&2
  exit 1
}

[[ $# -ge 2 ]] || usage
STATUS="$1"
SUMMARY="$2"
shift 2
DETAIL_FILE=""
WITHIN=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --detail-file) [[ $# -ge 2 ]] || usage; DETAIL_FILE="$2"; shift 2 ;;
    --within) [[ $# -ge 2 ]] || usage; WITHIN="$2"; shift 2 ;;
    *) usage ;;
  esac
done
case "$STATUS" in
  done | blocked | needs-you | waiting) ;;
  *) usage ;;
esac
[[ -n "$SUMMARY" ]] || usage
# 見込みは waiting にだけ付け、waiting には必ず付ける。既定の時間で補うと、thread の見込みと無関係な時刻で知らせることになる
if [[ "$STATUS" == "waiting" ]]; then
  [[ "$WITHIN" =~ ^[1-9][0-9]*$ ]] || usage
elif [[ -n "$WITHIN" ]]; then
  usage
fi
if [[ -n "$DETAIL_FILE" && ! -f "$DETAIL_FILE" ]]; then
  echo "detail のファイルがありません: $DETAIL_FILE" >&2
  exit 1
fi

# done の詳細に必ず置く欄の見出し。prompts/thread.md と prompts/coordinator.md の欄の名前とそろえる
DONE_SECTIONS=("確かめた根拠" "前提との食い違い")
# <ファイル> <見出し>: その見出し（どの段でもよく、後ろに補足があってもよい）があり、
# 次の同じ段か上の段の見出しまでに空でない行があれば成功する
has_section() {
  awk -v want="$2" '
    /^#+[ \t]/ {
      match($0, /^#+/)
      level = RLENGTH
      title = substr($0, level + 1)
      sub(/^[ \t]+/, "", title)
      if (inside && level <= inside_level) inside = 0
      if (index(title, want) == 1) { found = 1; inside = 1; inside_level = level; next }
    }
    inside && /[^ \t]/ { body = 1 }
    END { exit !(found && body) }
  ' "$1"
}
# done は、完了条件を確かめた方法と brief の前提との食い違いを、詳細の欄で必ず渡させる。
# prompt の指示だけでは読み飛ばされる（haiku-skips-startup-reads）ので、ここで断って直させる。
# 断る文に直し方を書くのは、指示の改訂前に起動した thread（system prompt は起動時のまま）にも同じ形で書かせるため
if [[ "$STATUS" == "done" ]]; then
  missing=()
  if [[ -z "$DETAIL_FILE" ]]; then
    missing=("${DONE_SECTIONS[@]}")
    echo "done の報告には --detail-file で詳細のファイル（report.md）を渡してください。" >&2
  else
    for section in "${DONE_SECTIONS[@]}"; do
      has_section "$DETAIL_FILE" "$section" || missing+=("$section")
    done
  fi
  if [[ ${#missing[@]} -gt 0 ]]; then
    # bash 3.2 の IFS は 1 バイト目しか使わないので、全角の区切りは自分でつなぐ
    joined=""
    for section in "${missing[@]}"; do joined+="${joined:+、}$section"; done
    {
      echo "done の報告を受け付けませんでした。詳細のファイルに、次の欄が無いか、見出しの下が空です: $joined"
      echo "次の 2 つの見出しを詳細のファイル（${DETAIL_FILE:-report.md}）に書き足し、同じ report をもう一度実行してください（status.json にも coordinator にも、まだ何も送っていません）。"
      echo ""
      echo "## 確かめた根拠"
      echo "（完了条件ごとに、確かめた方法。実行したコマンドと結果）"
      echo ""
      echo "## 前提との食い違い"
      echo "（brief の前提と食い違った事実。無ければ「なし」と書く。あれば報告の要約にも 1 文入れる）"
    } >&2
    exit 1
  fi
fi

if [[ -z "${HC_TERMINAL_ID:-}" ]]; then
  echo "hc の terminal の中で実行してください（HC_TERMINAL_ID がありません）" >&2
  exit 1
fi

MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"

# thread のフォルダは terminal の起動フォルダから決める。シェルの作業フォルダは thread が移動していることがある
DIR="$(hc get "$HC_TERMINAL_ID" --json | jq -er '.cwd')"
if [[ ! -f "$DIR/thread.json" || "$(basename "$(dirname "$DIR")")" != "threads" ]]; then
  echo "この terminal は thread ではありません（$DIR に thread.json が無い）" >&2
  exit 1
fi
THREAD_ID="$(basename "$DIR")"
PROJECT_DIR="$(dirname "$(dirname "$DIR")")"

NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# 詳細は報告ごとに別のファイルへ写し、渡されたファイルにも前の報告の写しにも書かない。
# report.md に写すと、ほかのファイルで報告したときに report.md に積み上げた前の報告が消える（pc-slow の t001）。
# report.md そのものを渡されても写すのは、thread が次の報告で report.md を書き直しても、この報告の内容を残すため
DETAIL=""
if [[ -n "$DETAIL_FILE" ]]; then
  mkdir -p "$DIR/reports"
  DETAIL="$DIR/reports/${NOW//[-:]/}-$STATUS.md"
  # 同じ秒に 2 回報告しても前の写しを上書きしない
  i=2
  while [[ -e "$DETAIL" ]]; do
    DETAIL="$DIR/reports/${NOW//[-:]/}-$STATUS-$i.md"
    i=$((i + 1))
  done
  cp "$DETAIL_FILE" "$DETAIL"
fi
# coordinator が追加の依頼を同じ thread に送るかを、context の大きさで決められるようにする。
# 取れなくても報告は通す。報告が coordinator に届かなくなるほうが困る
CONTEXT_TOKENS=""
SESSION="$(jq -r '.sessionId // empty' "$DIR/thread.json")"
if [[ -z "$SESSION" ]] || ! CONTEXT_TOKENS="$(context_tokens_of "$SESSION")"; then
  CONTEXT_TOKENS=""
  echo "context の大きさを取れませんでした（会話の記録が無いか、形式が変わった）。報告には付けません" >&2
fi
# thread が done を報告したら、coordinator が前の報告から書いた質問（question.md）は答えを待たずに済んだ（thread が自分で先へ進んだ）。
# 残すと一覧に古い質問が出続ける。一覧が 1 回の読み直しで済むよう status.json とラベルより先に閉じる。
# 閉じられなくても報告は通す（報告が coordinator に届かなくなるほうが困る）。
# blocked / needs-you では閉じない（coordinator が質問を書き直す）。waiting でも閉じない（答えを待ちながら別の作業の待ちに入ることがある）
if [[ "$STATUS" == "done" && -f "$DIR/question.md" ]] \
  && ! "$MOD_DIR/bin/close-question" "$PROJECT_DIR" "$THREAD_ID" "答えを送る前に thread が done を報告した: $SUMMARY" >/dev/null; then
  echo "未回答の質問（$DIR/question.md）を回答済みにできませんでした。報告は続けます" >&2
fi
EXPECTED_AT=""
if [[ -n "$WITHIN" ]]; then
  EXPECTED_AT="$(jq -nr --argjson now "$(date +%s)" --argjson within "$WITHIN" '$now + $within * 60 | todate')"
fi
# 一覧の mod が書きかけを読まないよう、書き終えてから置き換える
jq -n --arg status "$STATUS" --arg summary "$SUMMARY" --arg at "$NOW" --arg expectedAt "$EXPECTED_AT" --arg detail "$DETAIL" \
  --arg contextTokens "$CONTEXT_TOKENS" \
  '{status: $status, summary: $summary, at: $at}
    + (if $expectedAt == "" then {} else {expectedAt: $expectedAt} end)
    + (if $detail == "" then {} else {detail: $detail} end)
    + (if $contextTokens == "" then {} else {contextTokens: ($contextTokens | tonumber)} end)' \
  > "$DIR/status.json.tmp"
mv "$DIR/status.json.tmp" "$DIR/status.json"
# 一覧の mod はラベルの変化で描き直す。同じ status を続けて報告しても変化になるよう、時刻も付ける
hc label "$HC_TERMINAL_ID" "report=$STATUS" "report.at=$NOW" >/dev/null

NOTES=""
if [[ -n "$CONTEXT_TOKENS" ]]; then
  NOTES="context $(format_tokens "$CONTEXT_TOKENS")"
fi
if [[ -n "$EXPECTED_AT" ]]; then
  NOTES="${NOTES:+${NOTES}、}完了見込み: $(jq -nr --arg t "$EXPECTED_AT" '$t | fromdateiso8601 | strflocaltime("%H:%M")')"
fi
# 詳細を渡さなかった報告には詳細を付けない。前の報告の詳細を指すと、この報告の内容と取り違える
if [[ -n "$DETAIL" ]]; then
  NOTES="${NOTES:+${NOTES}、}詳細: $DETAIL"
fi
LINE="[thread $THREAD_ID $STATUS] $SUMMARY${NOTES:+ ($NOTES)}"
COORDINATOR="$(jq -r '.coordinator.terminal // empty' "$PROJECT_DIR/project.json")"
if [[ -n "$COORDINATOR" ]] && is_claude_with "$COORDINATOR" "$PROJECT_DIR/coordinator-prompt.md"; then
  # 作業の区切りで coordinator の会話が大きければ、user がその場にいるうちに引き継ぎを提案させる。
  # coordinator の会話の大きさが取れなくても報告は送る
  PROPOSED=""
  if [[ "$STATUS" != "waiting" ]] && coordinator_session_of "$PROJECT_DIR"; then
    COORDINATOR_SESSION="$REPLY"
    if COORDINATOR_TOKENS="$(context_tokens_of "$COORDINATOR_SESSION")" &&
      handoff_proposal_due "$PROJECT_DIR" "$COORDINATOR_SESSION" "$COORDINATOR_TOKENS" "$HANDOFF_PROPOSE_MIN_TOKENS"; then
      LINE+=" [project-threads cache] coordinator の context は $(format_tokens "$COORDINATOR_TOKENS") です。この報告をいつもどおり扱い、返事の最後に次の 1 行を添えてください: $(handoff_proposal_line "$COORDINATOR_TOKENS")"
      PROPOSED=1
    fi
  fi
  send_keeping_draft "$COORDINATOR" "$LINE" >/dev/null
  if [[ -n "$PROPOSED" ]]; then
    mark_handoff_proposed "$PROJECT_DIR" "$COORDINATOR_SESSION" "$COORDINATOR_TOKENS"
  fi
  echo "報告を記録し、coordinator ($COORDINATOR) に送りました"
else
  # coordinator は次に開いたときに status.json を読む
  echo "報告を記録しました。coordinator が動いていないので送っていません"
fi
