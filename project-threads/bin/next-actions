#!/usr/bin/env bash
# project の umbrella の配下で次に取れるアクションを、plugin devflow の skill /next-actions で 1 回集める。coordinator が
# 作業の区切りと user に聞かれたときに呼ぶ。project を置いた checkout で claude -p を非対話で動かし、
# 報告の全文を <project>/next-actions.md に書いて、AFK と HITL の行を stdout に返す。GitHub と追跡されているファイルは
# 書き換えない（走査が台帳の写し .local/devflow/ を更新するだけ）。
# 失敗したとき（走査が ERROR= で止まったとき・走査が回らなかったときを含む）は前の next-actions.md を残す。
#
# usage: next-actions <project のフォルダ>
set -euo pipefail

if [[ $# -ne 1 || ! -f "$1/project.json" ]]; then
  echo "usage: $0 <project のフォルダ>" >&2
  exit 1
fi
PROJECT_DIR="$(cd "$1" && pwd)"
# project は open が <repo>/.local/hc-projects/<name> に作る
REPO_ROOT="$(cd "$PROJECT_DIR/../../.." && pwd)"
REPORT="$PROJECT_DIR/next-actions.md"
LOCK="$PROJECT_DIR/next-actions.lock"
# 1 回の実行の打ち切り（秒）。local-projects の実測で 1〜2 分
TIMEOUT=600
# 費用を抑えるため Haiku で回す。分類は devflow の走査のスクリプトが決め、モデルはそれを報告の形に並べるだけなので足りる
MODEL=haiku

UMBRELLA="$(jq -r '.umbrella // empty' "$PROJECT_DIR/project.json")"
if [[ -z "$UMBRELLA" ]]; then
  echo "umbrella が登録されていません（bin/umbrella で登録します）" >&2
  exit 1
fi
if [[ ! "$UMBRELLA" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#([0-9]+)$ ]]; then
  echo "project.json の umbrella（${UMBRELLA}）を読めません（owner/repo#番号 の形で書きます）" >&2
  exit 1
fi
NUMBER="${BASH_REMATCH[1]}"

# plugin devflow（ishiyu/agent-plugins の devflow@agent-plugins）の走査のスクリプトの場所は、入れた版で変わるので
# claude plugin list --json の installPath で引く（1 秒弱。claude -p の 1〜3 分に比べて小さい）
if ! plugins="$(claude plugin list --json < /dev/null)"; then
  echo "claude plugin list --json が失敗しました（plugin devflow の場所を引けません）" >&2
  exit 1
fi
# 登録は版の違うものが並ぶのがふつう。Claude Code は repo の settings.local.json で有効にした plugin について、
# 下のフォルダで会話を起動するたびに、そのフォルダを projectPath にした local の登録をそのときの版で足し、
# plugin list は cwd に関係なく全部を返す。Claude Code 2.1.328 の実測では、読み込まれるのは起動したフォルダに
# 当てはまる登録（scope が user か、projectPath がそのフォルダかその親）のうち配列で先に来るものなので、
# claude -p を起動する REPO_ROOT について同じ規則で選ぶ（docs に記述が無く、版で変わりうる）。
# 出力は「選んだ installPath（無ければ空）」と「devflow@agent-plugins の登録の数」の 2 行。
# -e は出力が空のとき（plugin list が何も出さなかったとき）を失敗にするため
if ! devflow="$(jq -er --arg root "$REPO_ROOT" '
  if type != "array" then error("配列でない") else . end
  | [.[] | select(.id == "devflow@agent-plugins")] as $all
  | [$all[] | select(.scope == "user"
      or (.projectPath as $p | ($p | type) == "string" and ($root == $p or ($root | startswith($p + "/")))))]
  | (if length == 0 then "" else .[0].installPath end) as $path
  | if ($path | type) != "string" or ($path != "" and ($path | startswith("/") | not)) then error("installPath が絶対パスでない")
    else $path, ($all | length) end
' <<<"$plugins" 2>&1)"; then
  echo "claude plugin list --json の devflow@agent-plugins を読めません: ${devflow:0:300}" >&2
  exit 1
fi
DEVFLOW_ROOT="${devflow%$'\n'*}"
if [[ -z "$DEVFLOW_ROOT" ]]; then
  if [[ "${devflow##*$'\n'}" == 0 ]]; then
    echo "plugin devflow（devflow@agent-plugins）が入っていません（claude plugin install devflow@agent-plugins で入れます）" >&2
  else
    echo "plugin devflow（devflow@agent-plugins）は入っていますが、${REPO_ROOT} で読み込まれる登録（scope が user か、この repo を含むフォルダの local の登録）がありません（claude plugin install devflow@agent-plugins で user に入れます）" >&2
  fi
  exit 1
fi
SCAN="$DEVFLOW_ROOT/scripts/scan.sh"
if [[ ! -f "$SCAN" ]]; then
  echo "devflow@agent-plugins の走査のスクリプト（${SCAN}）がありません" >&2
  exit 1
fi
# plugin devflow は既定で無効なので、project を置いた repo の設定に頼らずここで有効にする
SETTINGS='{"enabledPlugins":{"devflow@agent-plugins":true}}'

# 同時に 2 つは回さない。打ち切りの時間を過ぎて残った印は、途中で止まった実行の残りとみなして消す
if [[ -d "$LOCK" && -n "$(find "$LOCK" -maxdepth 0 -mmin +$((TIMEOUT / 60 + 1)))" ]]; then
  rmdir "$LOCK"
fi
if ! mkdir "$LOCK" 2>/dev/null; then
  echo "ほかの next-actions が実行中です（${LOCK}）。終わってから回してください" >&2
  exit 1
fi
# 走査の成否は、走査のスクリプトが環境変数 DEVFLOW_SCAN_RESULT のファイルに書く（model を通らない）。
# claude -p は走査が止まっても成功し、model は判定を出さずに報告を返すので、model の出力では成否を見分けない
SCAN_RESULT="$(mktemp)"
trap 'rmdir "$LOCK"; rm -f "$SCAN_RESULT"' EXIT

SCHEMA='{
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "description": "報告の AFK と HITL の欄に出した行。1 行 1 件。人がやる は H ごとに 1 件に分ける",
      "items": {
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["AFK", "HITL"]},
          "action": {"type": "string", "description": "行頭のアクション名（エピックの作成 / 深掘り / 機能の起票 / Slice の起票 / 調査 / 書き戻し / 実装 / PR を見る / 閉じる / 人がやる）"},
          "issue": {"type": "integer", "description": "対象の issue 番号"},
          "humanTask": {"type": "string", "description": "人がやる の行は H の番号（例: H1）。ほかの行は空文字"},
          "title": {"type": "string", "description": "対象の題名。人がやる は H の題名"},
          "reason": {"type": "string", "description": "行の理由と診断（1〜2 文）"},
          "command": {"type": "string", "description": "添えるコマンド（例: /devflow:dig-slice 123）。無ければ空文字"}
        },
        "required": ["mode", "action", "issue", "humanTask", "title", "reason", "command"]
      }
    },
    "report": {"type": "string", "description": "/next-actions の報告の全文（Markdown）"}
  },
  "required": ["actions", "report"]
}'

# user の CLAUDE.md や hook がセッションの始めに振り返りなどを求めても、この実行ではしない
INSTRUCTION="このセッションは project-threads の bin/next-actions が非対話で起動した、${UMBRELLA} についての読み取り専用の実行です。
セッション開始のプロトコル（/retrospective・session-goal）は行いません。/next-actions の手順どおりに判定し、GitHub と repo の追跡されているファイルは書き換えません。走査が台帳の写し（.local/devflow/）を更新するのは構いません。
scan.sh は \`bash ${SCAN} <番号>\` の形で、cd・パイプ・リダイレクトを付けず、環境変数を前に置かずに 1 コマンドで実行してください。
最後に、AFK と HITL の欄に出した行を actions に 1 行ずつ入れ、/next-actions の報告の全文を report に入れて返してください。"

# 読み取りに要るツールだけを許し、ほかは聞かずに断る（dontAsk）。MCP は読まない（数百のツールの説明で context が膨らむ）。
# セッションを残さない（振り返りの対象にしない）。
# gh は許さない。判定の材料（issue の本文・PR の状態）は走査が GitHub で確かめて写しに置き、skill はそれを Read で読む。
# 走査は skill の frontmatter の allowed-tools と同じく bash <絶対パス> の形で許す。許可では版のフォルダ（installPath の
# 最後の段）を * にする。上の版の選び方が Claude Code の版で変わり、model が skill の ${CLAUDE_PLUGIN_ROOT}（実際に
# 読み込まれた版）で scan.sh を組んでも、許可に当たるようにするため。末尾は :* でなく「空白と *」にする
# （Claude Code 2.1.328 の実測で、:* の形では途中の * が当たらなかった）
# DEVFLOW_SCAN_RESULT は claude -p の起動の環境に置く（走査まで届く）。model がコマンドの前に置くと許可の形に当たらない
# macOS に timeout は無いので、perl の alarm で打ち切る（打ち切ると終了コードは 142）
ran=0
output="$(cd "$REPO_ROOT" && DEVFLOW_SCAN_RESULT="$SCAN_RESULT" perl -e 'alarm shift; exec @ARGV or die "exec: $!\n"' "$TIMEOUT" \
  claude -p "/next-actions $NUMBER" \
  --model "$MODEL" \
  --output-format json \
  --json-schema "$SCHEMA" \
  --append-system-prompt "$INSTRUCTION" \
  --no-session-persistence \
  --strict-mcp-config \
  --settings "$SETTINGS" \
  --exclude-dynamic-system-prompt-sections \
  --permission-mode dontAsk \
  --tools Bash Read Grep Glob Skill \
  --allowedTools "Bash(bash ${DEVFLOW_ROOT%/*}/*/scripts/scan.sh *)" Read Grep Glob Skill < /dev/null)" || ran=$?

if [[ "$ran" -eq 142 ]]; then
  echo "claude -p が $((TIMEOUT / 60)) 分で終わらないので打ち切りました" >&2
  exit 1
fi
if ! jq -e 'type == "object"' <<<"$output" >/dev/null 2>&1; then
  echo "claude -p が失敗しました（exit ${ran}）: ${output:0:200}" >&2
  exit 1
fi
if [[ "$ran" -ne 0 ]] || jq -e '.is_error == true' <<<"$output" >/dev/null; then
  echo "claude -p が失敗しました（$(jq -r --arg code "exit $ran" '.subtype // $code' <<<"$output")）: $(jq -r '.result // "" | .[:200]' <<<"$output")" >&2
  exit 1
fi
# 走査が止まっても、model が走査を呼ばなくても（許可で断られたときを含む）、skill は報告を返して claude -p は成功する。
# actions が空でも「やることが無い」とは限らないので、走査が書いた成否で見分ける
scan_status=""
scan_error=""
{ IFS= read -r scan_status || true; IFS= read -r scan_error || true; } < "$SCAN_RESULT"
case "$scan_status" in
  RESULT=ok) ;;
  RESULT=error)
    echo "走査（scan.sh）が止まりました: ${scan_error:0:300}" >&2
    exit 1
    ;;
  "")
    echo "走査（scan.sh）が回りませんでした（model が走査を呼ばなかったか、許可で断られた）" >&2
    exit 1
    ;;
  *)
    echo "走査（scan.sh）の成否を読めません: ${scan_status:0:200}" >&2
    exit 1
    ;;
esac
if ! jq -e '
  .structured_output
  | (.report | type) == "string"
    and (.actions | type) == "array"
    and all(.actions[];
      (.mode == "AFK" or .mode == "HITL")
      and (.issue | type) == "number" and .issue == (.issue | floor)
      and all(.action, .humanTask, .title, .reason, .command; type == "string"))
' <<<"$output" >/dev/null; then
  echo "claude -p の結果が決めた形（actions と report）になっていません" >&2
  exit 1
fi

jq -r --arg umbrella "$UMBRELLA" --arg at "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" --arg model "$MODEL" '
  "# /next-actions \($umbrella)\n\n"
  + "\($at) に bin/next-actions が \($model) で実行"
  + (if (.total_cost_usd | type) == "number" then "（$\(.total_cost_usd * 1000 | round / 1000)）" else "" end)
  + "。\n\n\(.structured_output.report)"
' <<<"$output" > "$REPORT"

jq -r --arg report "$REPORT" '
  def line: "- \(.action) #\(.issue)\(if .humanTask == "" then "" else " \(.humanTask)" end) \(.title) — \(.reason)"
    + (if .command == "" then "" else " → \(.command)" end);
  def section($mode; $label):
    [.structured_output.actions[] | select(.mode == $mode) | line] as $lines
    | if ($lines | length) == 0 then "\($label): なし" else "\($label):\n\($lines | join("\n"))" end;
  section("AFK"; "AFK（投げれば回る）"), section("HITL"; "HITL（人が座る）"), "全文: \($report)"
' <<<"$output"
