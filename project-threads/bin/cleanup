#!/usr/bin/env bash
# 終わった thread を、その worktree・ローカルブランチと一緒にまとめて片付ける。coordinator が呼ぶ。
# id を付けずに呼ぶと、消せる thread と残す thread の一覧を出すだけで、何も消さない。
# id を付けて呼ぶと、直前の一覧の「消せる」に載った id だけを、消す直前に判定し直してから消す。
# 一覧と結果は短く出す。coordinator は片付けのたびに一覧を出し、その出力がそのまま coordinator の会話の context に積もるため。
# 消せる thread は題名と、どの thread にも決まって行うこと（terminal と一時フォルダを消す、など）のほかだけを添え、
# 残す thread は理由の種類ごとに id を並べる。--verbose を付けると、消すものの全部と、残す thread の題名と理由の全文を出す。
#
# 消せるのは、次をすべて満たす thread:
#   - 最後の報告が done で、その後に追加の依頼を受けていない（terminal のラベルの報告時刻が status.json と合う）
#   - terminal が作業中・許可待ち・エラーでない
#   - worktrees.txt に記録した worktree がどれも、未コミットの変更（追跡していないファイルを含む）が無く、
#     ブランチが取り込み済み。取り込み済みは、先頭のコミットが default branch の祖先か、先頭のコミットを含む PR がマージ済み
#     （コミットの associatedPullRequests を見る。squash merge も拾う）
# 消すのは、記録した worktree とそのローカルブランチ、thread の terminal、thread の claude の一時フォルダ（scratchpad など）。
# thread のフォルダは threads/.deleted/ へ移す。リモートのブランチは消さない。worktrees.txt が無い thread は、thread だけを片付ける。
# message が新しい thread に引き継いだ thread（thread.json の supersededBy）は、引き継ぎ先が残っている間は残し、引き継ぎ先を
# 消すときに一緒に消す（引き継ぎ先の brief がこのフォルダを指す。worktree は引き継ぎ先に移してある）。引き継ぎ先がもう無ければ、
# 報告（superseded）を待たずに、ほかの thread と同じく判定する。
# 一時フォルダは、場所が確かなときだけ消す。確かでないときは理由を出して、残りの片付けを続ける。
# 移した後に、報告の写し（reports/<時刻>-<status>.md）を減らす。中身が後の写しか report.md にそのまま含まれる写しを消し、
# それでも 2 つ以上残れば、haiku に summary.md を書かせてから、最後の写しのほかを消す。要約に失敗したら写しは残す。
# thread を消した後に、回送の写し（relay が添付を写した relays/<回送 id>/）のうち、届いてから 7 日を過ぎ、片付けていない
# thread の brief.md のどれにも書かれていないものを消す。一覧には、消せる thread を消した後に当てはまる写しを出す。
#
# --merged を付けると、マージ後の片付けをする。user が PR のマージを伝えたときに coordinator が呼ぶ。消せるかの判定は
# 上と同じで、違うのは次の 3 つだけ:
#   - 一覧を出さずに、消せる thread をその場で消す（user の承認を省く。user が決めた）
#   - 取り込み済みを確かめた worktree が 1 つも無い thread（worktrees.txt が無い・記録した worktree がもう無い）は消さない
#   - 残す理由が「merge queue 中の PR」だけの thread は、その PR を thread の prs.json に「マージされたら片付ける」印
#     （cleanupOnMerge）つきで書く。見張り（bin/pr-watch）がマージを確かめたら --pr-merged で消し、結果を coordinator に送る
#
# --pr-merged <id> は、--merged で merge queue 中だった PR のマージを確かめた見張りが呼ぶ。渡した thread だけを --merged と同じ
# 判定で消す（--merged は全 thread が対象で、coordinator がローカルで取り込み、user がまだ確かめていない thread まで消すため）。
# 結果の 1 行を出し、終了コードでも返す: 0 消した / 3 残した（理由がマージの反映の遅れでありうるものだけ。見張りが試し直す）/
# 1 残した・失敗 / 75 ほかの片付けが動いている
#
# 消す呼び出し（id つき・--merged・--handoff・--pr-merged）は project に 1 本ずつにする（take_lock）。見張りが自動で消すので、
# 引き継ぎの片付けや user の --merged と同じ thread を同時に消し合わないため。--pr-merged は待たずに 75 で終わり、ほかは待つ
#
# --handoff を付けると、coordinator の会話の引き継ぎのときの片付けをする。handoff の補助が呼ぶ。消せる thread を一覧を出さずに
# その場で消す（user が引き継ぎを頼んだことを承認とみなす。user が決めた）。判定は一覧と同じで、ほかに次の thread を残す:
#   - progress（memory/progress.md）の「動いている thread」の節に id がある。coordinator が、done でも user の確認や続きの依頼を
#     待つ thread をそこに書く
#   - progress より後に status.json を書いた（引き継ぎの間に報告した）。/clear の後の会話は、その報告を status.json で拾う
# 結果は /clear の後の最初の入力に添えるので、消した thread は id だけを出す。
#
# --deleted を付けると、片付け済みの thread（threads/.deleted/）の報告の写しを、片付けのときと同じように減らす。
# 写しを減らす処理ができる前に片付けた thread のため。id を付けなければ一覧を出すだけで、一覧に載った id を付けると
# 判定し直してから減らす。summary.md がある thread・写しが 1 つ以下の thread には何もしないので、何度呼んでも結果は変わらない。
#
# usage: cleanup <project のフォルダ> [<thread の id>...]
#        cleanup <project のフォルダ> --verbose
#        cleanup <project のフォルダ> --merged
#        cleanup <project のフォルダ> --deleted [<thread の id>...]
#        cleanup <project のフォルダ> --pr-merged <thread の id>   （見張りの bin/pr-watch が呼ぶ）
#        cleanup <project のフォルダ> --handoff   （handoff の補助が呼ぶ）
set -euo pipefail

usage() {
  echo "usage: $0 <project のフォルダ> [<thread の id>...]" >&2
  echo "       $0 <project のフォルダ> --verbose" >&2
  echo "       $0 <project のフォルダ> --merged" >&2
  echo "       $0 <project のフォルダ> --deleted [<thread の id>...]" >&2
  exit 1
}

[[ $# -ge 1 && -f "$1/project.json" ]] || usage
PROJECT_DIR="$(cd "$1" && pwd)"
shift
DELETED_MODE=""
MERGED_MODE=""
HANDOFF_MODE=""
VERBOSE=""
case "${1:-}" in
  --verbose)
    [[ $# -eq 1 ]] || usage
    VERBOSE=1
    shift
    ;;
  --handoff)
    [[ $# -eq 1 ]] || usage
    HANDOFF_MODE=1
    shift
    ;;
  --deleted)
    DELETED_MODE=1
    shift
    ;;
  --merged)
    [[ $# -eq 1 ]] || usage
    MERGED_MODE=1
    shift
    ;;
  --pr-merged)
    [[ $# -eq 2 ]] || usage
    MERGED_MODE="pr"
    shift
    ;;
esac
MOD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=SCRIPTDIR/_lib.sh
source "$MOD_DIR/bin/_lib.sh"
DELETED_DIR="$PROJECT_DIR/threads/.deleted"
# 一覧を出さずに消すのを防ぐため、一覧の「消せる」に載せた id をここに残す。消すのは 1 回だけに使う。
# --deleted の一覧は別のファイルに残し、片付けの一覧と取り違えないようにする
if [[ -n "$DELETED_MODE" ]]; then
  LISTED="$PROJECT_DIR/cleanup-deleted-listed"
else
  LISTED="$PROJECT_DIR/cleanup-listed"
fi

# judge_thread が書き、一覧と削除が読む判定の結果。macOS の bash 3.2 は set -u で空の配列を展開できないので、件数を別に持つ
PROBLEMS=""      # 残す理由（" / " 区切り）
PROBLEM_KINDS="" # 残す理由の種類（1 行に 1 つ、重ねない）。短い一覧で、残す thread を種類ごとにまとめる
PROBLEM_COUNT=0  # 残す理由の数。merge queue の待ちだけで残すのかを、QUEUE_COUNT と比べて決める
ACTIONS=""       # 消すものの説明（" / " 区切り）
NOTES=""         # 短い一覧に出す、消すものの説明（" / " 区切り）。どの thread にも決まって行うことは入れない
WT_COUNT=0       # 消す worktree の数（取り込み済みを確かめた worktree の数）
WT_PATHS=()
WT_REPOS=()      # worktree とブランチを消すときに git -C で使う元の checkout
WT_BRANCHES=()
WT_RECORDED=""   # worktrees.txt に 1 行以上の記録があれば 1
MERGED_NOTES=""  # 取り込み済みと確かめた根拠（" / " 区切り）。--merged は一覧を出さないので、結果の行に添える
QUEUE_COUNT=0    # 未マージの理由が merge queue 中の PR である worktree の数
QUEUE_PRS=""     # その PR。「<元の checkout><TAB><PR の番号>」を 1 行ずつ
TERMINAL=""
TERMINAL_STATE="" # live / finished。terminal がもう無ければ空
AWAITS_SUCCESSOR="" # 引き継ぎ先が残っているので残すなら 1。--merged は、同じ回で引き継ぎ先と一緒に消えたかを見てから残す理由に出す
SCRATCH=""        # 消す claude の一時フォルダ。消さないとき・見つからないときは空
SCRATCH_NOTE=""   # 一時フォルダを消さない理由。見つからない（もう消えている）ときは空

add_problem() { # <理由> <理由の種類>
  PROBLEMS="${PROBLEMS:+$PROBLEMS / }$1"
  PROBLEM_COUNT=$((PROBLEM_COUNT + 1))
  if [[ $'\n'"$PROBLEM_KINDS"$'\n' != *$'\n'"$2"$'\n'* ]]; then PROBLEM_KINDS+="${PROBLEM_KINDS:+$'\n'}$2"; fi
}
# 短い一覧での説明を 2 つ目に渡す。省くと 1 つ目と同じで、空なら短い一覧には出さない
add_action() { # <説明> [<短い一覧での説明>]
  ACTIONS="${ACTIONS:+$ACTIONS / }$1"
  if [[ -n "${2-$1}" ]]; then NOTES="${NOTES:+$NOTES / }${2-$1}"; fi
}

# 残す thread を、理由の種類ごとにまとめる。KIND_NAMES[i] の種類で残す thread の id を、KIND_IDS[i] に「・」区切りで持つ
KIND_NAMES=()
KIND_IDS=()
group_kinds() { # <thread の id> <理由の種類（1 行に 1 つ）>
  local kind i
  while IFS= read -r kind; do
    for ((i = 0; i < ${#KIND_NAMES[@]}; i++)); do
      if [[ "${KIND_NAMES[i]}" == "$kind" ]]; then
        KIND_IDS[i]+="・$1"
        continue 2
      fi
    done
    KIND_NAMES+=("$kind")
    KIND_IDS+=("$1")
  done <<<"$2"
}
# 残す thread の短い一覧を出す。理由の全文と題名は --verbose の一覧で見られることを添える
print_kept_kinds() { # <残す thread の数>
  local i text=""
  if [[ "$1" -eq 0 ]]; then
    echo "残す thread（0 件）"
    return
  fi
  for ((i = 0; i < ${#KIND_NAMES[@]}; i++)); do text+="${text:+ / }${KIND_NAMES[i]} ${KIND_IDS[i]}"; done
  echo "残す thread（$1 件）: $text"
  echo "（残す thread の題名と理由の全文は、id を付けずに --verbose を付けて呼ぶと出ます。何も消しません）"
}

# judge_reports が書く、報告の写しの判定の結果。どちらも古い順
DROP_COUNT=0 # 中身がほかに含まれるので消す写しの数
DROPS=()
KEEP_COUNT=0 # 残す写しの数。2 つ以上なら要約を作る
KEEPS=()
# 要約は 1 本あたり数十秒かかるので、複数の thread の分を同時に回す。claude を起動しすぎないよう、この数ずつにする
SUMMARY_JOBS=4
# 要約 1 本の打ち切り（秒）。haiku で 10〜30 秒の見込み。ここで止まると片付け全体が待つので、next-actions より短くする
SUMMARY_TIMEOUT=120
# 要約 1 本の費用の上限（ドル）。数十 KB の写しなら $0.01〜0.05 の見込みで、大きすぎる写しを渡したときの歯止め
SUMMARY_BUDGET=0.3
SUMMARY_MODEL=haiku
SUMMARY_PROMPT='あなたは project-threads の bin/cleanup から非対話で呼ばれ、片付ける thread の要約を Markdown で書きます。ツールは使えません。
入力は、thread への依頼（brief.md）と、thread が作業の区切りごとに残した報告の写し（古い順）です。thread は報告のたびに前の内容を書き直すことがあり、この要約を書いた後に、最後の写しのほかは消えます。途中の写しにしか無い調査の結果・選択肢・決定を残すことが目的です。

次の 4 つの節だけを、この順に、見出しを変えずに書きます。
## 頼まれたこと
## 決めたこと
## 結果とコミット
## 未確認の点や残したこと

- 頼まれたこと: 依頼の目的と完了条件を 2〜4 行で
- 決めたこと: user や coordinator が選んだ案と、選ばなかった案、その理由。途中の報告で出た調査の結論も含める。誰が決めたかが書かれていれば添える
- 結果とコミット: ブランチ・worktree・コミットのハッシュ・テストの結果。最後の写しは消さずに残るので、そこに詳しく書かれていることは短く済ませてよい
- 未確認の点や残したこと: 確かめていないこと、後に回したこと、coordinator や user に頼んだこと
- 最後の写しに無く、途中の写しにだけある内容には、行末に（途中の報告: <ファイル名>）を添える
- 入力に書かれていないことは書かない。推測で補わない。当てはまるものが無い節には「なし」と書く
- ハッシュ・パス・コマンド・数値は入力のまま写す
- 前置きや結びの文は書かない。全体で 60 行以内にする'

# thread の claude の会話の一時フォルダ（scratchpad と、裏で動かしたコマンドの出力の tasks/）を探す。
# Claude Code は <CLAUDE_CODE_TMPDIR か /tmp>/claude-<uid>/<作業フォルダの絶対パスの英数字以外を - にした名前>/<会話の id>/ に作り、
# セッションが終わっても消さない（消えるのは macOS の tmp_cleaner の 3 日・Claude Code の保持期間の掃除・再起動だけ）。
# --resume で再開しても会話の id は変わらないので、thread 1 本につき 1 つ。起動のたびに別の id の空のフォルダもできるが、それは消さない。
# 会話の id だけで探さず、thread のフォルダの名前の下だけを見る。thread.json の id が誤っていても、ほかの作業フォルダのものを消さないため
judge_scratchpad() { # <thread の id>
  local dir="$PROJECT_DIR/threads/$1" session base root path folder link LC_ALL=C
  SCRATCH="" SCRATCH_NOTE=""
  session="$(jq -r '.sessionId // empty' "$dir/thread.json")"
  # 空や ../ を含む id でパスを組み立てると、消す範囲が thread の外に広がる
  if [[ ! "$session" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    SCRATCH_NOTE="thread.json の会話の id（${session:-なし}）が UUID の形でない"
    return
  fi
  base="${CLAUDE_CODE_TMPDIR:-/tmp}"
  if [[ "$base" != /* ]]; then
    SCRATCH_NOTE="CLAUDE_CODE_TMPDIR（${base}）が絶対パスでない"
    return
  fi
  root="${base%/}/claude-$UID"
  # 作業フォルダはシンボリックリンクを解いた形で記録されうるので、両方を見る
  for path in "$dir" "$(cd "$dir" && pwd -P)"; do
    # Claude Code は 200 文字を超える名前を先頭 200 文字と - とハッシュにし、英数字以外を UTF-16 の単位で - にする。どちらも実物で確かめていない
    if [[ ${#path} -gt 200 || "$path" =~ [^[:print:]] ]]; then
      SCRATCH_NOTE="thread のフォルダのパスが 200 文字を超えるか ASCII 以外の文字を含み、名前を確かめられない"
      return
    fi
    folder="$root/${path//[^a-zA-Z0-9]/-}"
    for link in "$folder" "$folder/$session"; do
      if [[ -L "$link" ]]; then
        SCRATCH_NOTE="$link がシンボリックリンク"
        return
      fi
    done
    if [[ -d "$folder/$session" ]]; then
      SCRATCH="$folder/$session"
      return
    fi
  done
}


# ファイルの中身を REPLY に読む。末尾の改行は落とす（含まれるかの判定が、末尾の改行の有無で外れないようにする）
read_text() { # <ファイル>
  REPLY=""
  IFS= read -rd '' REPLY < "$1" || true
  while [[ "$REPLY" == *$'\n' ]]; do REPLY="${REPLY%$'\n'}"; done
}

# 報告の写しを、消すもの（DROPS）と残すもの（KEEPS）に分ける。ファイルには触らない。
# 写しの名前は bin/report が付ける <UTC の時刻>-<status>.md（同じ秒の 2 つ目からは -2・-3）で、ほかの名前のファイルは数えない。
# 最後の写しは必ず残す（status.json の detail が名前で指している）。ほかの写しは新しい順に、残すと決めたファイル
# （report.md・最後の写し・それまでに残すと決めた写し）のどれかに中身がそのまま含まれれば消す。消す写しの中身は
# 必ず残るファイルにあるので、何も失わない。「含まれる」は文字の並びがそのまま現れることだけで、1 行でも書き換えた写しは残す
judge_reports() { # <thread のフォルダ>
  local dir="$1" file name kept text i LC_ALL=C
  local -a sorted=() kept_texts=()
  DROP_COUNT=0 DROPS=() KEEP_COUNT=0 KEEPS=()
  [[ -d "$dir/reports" ]] || return 0
  # 時刻、同じ秒の何番目か、名前の順に並べる。名前の順だけだと、-2 の付いた写しが付かない写しより前に来る
  while IFS= read -r name; do
    sorted+=("$dir/reports/${name##* }")
  done < <(
    for file in "$dir"/reports/*.md; do
      name="${file##*/}"
      if [[ "$name" =~ ^([0-9]{8}T[0-9]{6}Z)-(done|blocked|needs-you|waiting)(-([1-9][0-9]*))?\.md$ ]]; then
        printf '%s %06d %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[4]:-1}" "$name"
      fi
    done | sort
  )
  [[ ${#sorted[@]} -gt 0 ]] || return 0
  if [[ -f "$dir/report.md" ]]; then
    read_text "$dir/report.md"
    kept_texts+=("$REPLY")
  fi
  KEEPS=("${sorted[${#sorted[@]} - 1]}")
  read_text "${KEEPS[0]}"
  kept_texts+=("$REPLY")
  for ((i = ${#sorted[@]} - 2; i >= 0; i--)); do
    read_text "${sorted[$i]}"
    text="$REPLY"
    for kept in "${kept_texts[@]}"; do
      if [[ "$kept" == *"$text"* ]]; then
        DROPS=("${sorted[$i]}" ${DROPS[@]+"${DROPS[@]}"})
        continue 2
      fi
    done
    KEEPS=("${sorted[$i]}" "${KEEPS[@]}")
    kept_texts+=("$text")
  done
  DROP_COUNT=${#DROPS[@]}
  KEEP_COUNT=${#KEEPS[@]}
}

# 一覧に出す、報告の写しをどうするかの説明。何もしないときは何も出さない
reports_text() { # <消す写しの数> <残す写しの数>
  local drop="$1" keep="$2" summary
  summary="$SUMMARY_MODEL で summary.md を作って、最後の 1 つのほかを消す（要約に失敗したら残す）"
  if [[ "$keep" -ge 2 && "$drop" -gt 0 ]]; then
    echo "報告の写し $((drop + keep)) つのうち、後の写しか report.md に中身が含まれる $drop つを消し、残る $keep つから $summary"
  elif [[ "$keep" -ge 2 ]]; then
    echo "報告の写し $keep つから $summary"
  elif [[ "$drop" -gt 0 ]]; then
    echo "報告の写し $((drop + keep)) つのうち、後の写しか report.md に中身が含まれる $drop つを消す"
  fi
}

# 移した後の thread のフォルダで、中身がほかに含まれる写しを消す。要約を作るか（残る写しが 2 つ以上か）を
# NEED_SUMMARY に、消した結果の説明を REPORTS_RESULT に、消せなかったときだけその説明を REPORTS_ERROR にも入れる。
# 片付けの結果には REPORTS_ERROR だけを出す（中身は残るファイルにあるので、消せたことは伝えなくてよい）。要約に渡す写しは KEEPS に残る
prune_reports() { # <thread のフォルダ>
  local out
  NEED_SUMMARY="" REPORTS_RESULT="" REPORTS_ERROR=""
  judge_reports "$1"
  if [[ "$DROP_COUNT" -gt 0 ]]; then
    if out="$(rm -f -- "${DROPS[@]}" 2>&1)"; then
      REPORTS_RESULT="報告の写しのうち、後の写しか report.md に中身が含まれる $DROP_COUNT つを消した"
    else
      REPORTS_ERROR="報告の写しのうち、中身がほかに含まれる写しを消しきれない: ${out:0:200}"
      REPORTS_RESULT="$REPORTS_ERROR"
    fi
  fi
  if [[ "$KEEP_COUNT" -ge 2 ]]; then NEED_SUMMARY=1; fi
}

# 残った写しから haiku に summary.md を書かせ、書けたことを確かめてから最後の写しのほかを消す。
# 結果の説明を stdout に 1 行で出す。失敗したら写しは消さない。片付けは止めないので、いつも 0 で終わる
summarize_thread() { # <thread のフォルダ> <thread の id> <題名> <残した写し...（古い順）>
  local dir="$1" id="$2" title="$3" input file names="" output ran=0 started elapsed cost result
  local -a files=("${@:4}")
  local last="${files[${#files[@]} - 1]}"
  input="thread ${id}「${title}」を片付ける前に、次のファイルを要約してください。"
  if [[ -f "$dir/brief.md" ]]; then
    read_text "$dir/brief.md"
    input+=$'\n\n<file name="brief.md">\n'"$REPLY"$'\n</file>'
  fi
  for file in "${files[@]}"; do
    read_text "$file"
    input+=$'\n\n<file name="reports/'"${file##*/}"$'">\n'"$REPLY"$'\n</file>'
    names="${names:+${names}、}${file##*/}"
  done
  started=$SECONDS
  # ツールを持たせず、user の設定（hook など）と MCP とスキルを読まない。system prompt を差し替えるので、入力はほぼ写しだけになる。
  # 打ち切りは perl の alarm（終了コード 142）。作業フォルダは thread のフォルダにする
  output="$(cd "$dir" && perl -e 'alarm shift; exec @ARGV or die "exec: $!\n"' "$SUMMARY_TIMEOUT" \
    claude -p \
    --model "$SUMMARY_MODEL" \
    --output-format json \
    --system-prompt "$SUMMARY_PROMPT" \
    --tools "" \
    --setting-sources "" \
    --strict-mcp-config \
    --disable-slash-commands \
    --no-session-persistence \
    --max-budget-usd "$SUMMARY_BUDGET" <<<"$input")" || ran=$?
  elapsed=$((SECONDS - started))
  if [[ "$ran" -eq 142 ]]; then
    echo "要約を作れなかった（${SUMMARY_TIMEOUT} 秒で打ち切った）ので、報告の写しは残した"
    return 0
  fi
  if ! jq -e 'type == "object"' <<<"$output" >/dev/null 2>&1; then
    echo "要約を作れなかった（claude -p が exit ${ran}: ${output:0:200}）ので、報告の写しは残した"
    return 0
  fi
  if [[ "$ran" -ne 0 ]] || jq -e '.is_error == true' <<<"$output" >/dev/null; then
    echo "要約を作れなかった（claude -p が $(jq -r --arg code "exit $ran" '.subtype // $code' <<<"$output"): $(jq -r '.result // "" | tostring | .[:200]' <<<"$output")）ので、報告の写しは残した"
    return 0
  fi
  result="$(jq -r '.result // "" | strings' <<<"$output")"
  if [[ ! "$result" =~ [^[:space:]] ]]; then
    echo "要約を作れなかった（claude -p の出力が空）ので、報告の写しは残した"
    return 0
  fi
  cost="$(jq -r 'if (.total_cost_usd | type) == "number" then "$\(.total_cost_usd * 1000 | round / 1000)" else "費用は不明" end' <<<"$output")"
  # 書き終えてから置き換え、置き換えたファイルが空でないことを確かめるまで写しを消さない
  if ! {
    printf '# %s「%s」の要約\n\n' "$id" "$title"
    printf '%s に bin/cleanup が %s で、brief.md と報告の写し %s つ（%s）から作った（%s 秒、%s）。最後の写し（reports/%s）のほかの写しは、この要約を書いた後に消した。\n\n' \
      "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" "$SUMMARY_MODEL" "${#files[@]}" "$names" "$elapsed" "$cost" "${last##*/}"
    printf '%s\n' "$result"
  } > "$dir/summary.md.tmp" || ! mv "$dir/summary.md.tmp" "$dir/summary.md" || [[ ! -s "$dir/summary.md" ]]; then
    rm -f "$dir/summary.md.tmp"
    echo "要約を summary.md に書けなかったので、報告の写しは残した"
    return 0
  fi
  if ! output="$(rm -f -- "${files[@]:0:${#files[@]}-1}" 2>&1)"; then
    echo "summary.md を作ったが、途中の報告の写しを消しきれない: ${output:0:200}"
    return 0
  fi
  echo "summary.md を作り（${elapsed} 秒、${cost}）、途中の報告の写し $((${#files[@]} - 1)) つを消した"
}

# 取り込みを確かめる先を 1 行ずつ出す。origin/HEAD が分かればローカルと origin の両方、分からなければローカルの main だけ
default_refs() { # <repo>
  local remote
  if remote="$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" && [[ -n "$remote" ]]; then
    echo "${remote#origin/}"
    echo "$remote"
  else
    echo main
  fi
}

# 先頭のコミットを GitHub の PR で確かめ、REPLY に「merged <PR の番号>」「queued <PR の番号>」「unmerged」のどれかを入れる。
# gh が失敗したら、REPLY にその出力を入れて失敗する。gh を 1 回だけ呼び、先頭のコミットを含む PR（コミットの associatedPullRequests）を取る。
# ブランチを head に持つ PR のほか、自分の PR を持たないブランチ（検証用のブランチ、統合ブランチに merge commit で入った agent slot の
# ブランチ）と、PR の head より遅れたローカルのブランチも拾う。squash merge で default branch に入らなかったコミットでも、マージ済みの PR を返す。
# PR の検索（is:pr <SHA>）は使わない。本文やコメントに SHA が書かれているだけの PR も返し、未マージのブランチをマージ済みと誤るため。
# GitHub に無いコミット（push していない）は object が null になり、未マージになる。
# マージ済みの PR があれば merged、無くて merge queue 中の PR があれば queued
PR_QUERY='query($owner: String!, $name: String!, $oid: GitObjectID!) {
  repository(owner: $owner, name: $name) {
    object(oid: $oid) { ... on Commit { associatedPullRequests(first: 50) { nodes { number state isInMergeQueue } } } }
  }
}'
PR_FILTER='
  [.data.repository.object.associatedPullRequests.nodes[]?] as $prs
  | first($prs[] | select(.state == "MERGED") | "merged \(.number)")
    // first($prs[] | select(.state == "OPEN" and .isInMergeQueue) | "queued \(.number)")
    // "unmerged"'
pr_merge_state() { # <元の checkout> <先頭のコミット>
  local out
  # {owner}・{repo} は gh が作業フォルダの repo に置き換える。-F は数字に見える値を数にするので、コミットは -f で渡す
  if ! out="$(cd "$1" && gh api graphql -F owner='{owner}' -F name='{repo}' -f oid="$2" -f query="$PR_QUERY" 2>&1)"; then
    REPLY="$out"
    return 1
  fi
  if ! REPLY="$(jq -r "$PR_FILTER" <<<"$out" 2>/dev/null)" || [[ -z "$REPLY" ]]; then
    REPLY="応答を読めない: $out"
    return 1
  fi
}

judge_worktree() { # <worktrees.txt に記録された path>
  local path="$1" out top common branch repo real sha ref merged="" number i
  local -a refs=()
  # 記録の誤りや git の失敗は、まれで中身がまちまちなので、短い一覧では 1 つの種類にまとめる
  local broken="記録した worktree を確かめられない"
  if [[ "$path" != /* ]]; then
    add_problem "worktrees.txt の $path が絶対パスでない" "$broken"
    return
  fi
  # coordinator が手で消した後など。何が消えたか分からないので、ブランチにも触らない
  if [[ ! -e "$path" ]]; then
    add_action "worktree $path はもう無い（ブランチは確かめていない）" "worktree ${path##*/} はもう無い（ブランチは確かめていない）"
    return
  fi
  if ! out="$(git -C "$path" rev-parse --path-format=absolute --show-toplevel --git-common-dir --abbrev-ref HEAD 2>&1)"; then
    add_problem "$path を git の worktree として読めない: ${out:0:200}" "$broken"
    return
  fi
  { read -r top; read -r common; read -r branch; } <<<"$out"
  repo="${common%/.git}"
  real="$(cd "$path" && pwd -P)"
  # 元の checkout と、worktree の中のフォルダは消さない。記録の誤りで repo ごと消すのを防ぐ
  if [[ "$top" == "$repo" ]]; then
    add_problem "$path は元の checkout（${repo}）で、git worktree add で作った worktree ではない" "$broken"
    return
  fi
  if [[ "$top" != "$real" ]]; then
    add_problem "$path は worktree の最上位（${top}）ではない" "$broken"
    return
  fi
  if [[ "$branch" == "HEAD" ]]; then
    add_problem "$path がブランチに乗っていない（detached HEAD）" "$broken"
    return
  fi
  while IFS= read -r ref; do refs+=("$ref"); done < <(default_refs "$repo")
  # default branch そのものは、自分の祖先なので取り込み済みに見える。消さない
  if [[ "$branch" == "${refs[0]}" ]]; then
    add_problem "$path は default branch（${branch}）を checkout している" "$broken"
    return
  fi
  for ((i = 0; i < WT_COUNT; i++)); do
    [[ "${WT_PATHS[$i]}" == "$top" ]] && return
  done
  if ! out="$(git -C "$path" status --porcelain 2>&1)"; then
    add_problem "$path の git status が失敗: ${out:0:200}" "$broken"
    return
  fi
  if [[ -n "$out" ]]; then
    add_problem "$path に未コミットの変更がある" "未コミットの変更"
    return
  fi
  sha="$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch")"
  for ref in "${refs[@]}"; do
    if git -C "$repo" merge-base --is-ancestor "$sha" "$ref" 2>/dev/null; then
      merged="$ref に取り込み済み"
      break
    fi
  done
  # squash merge のブランチは default branch の祖先にならず、merge commit でも手元の origin/main が古ければ祖先に見えないので、
  # マージ済みの PR を探す。マージの後にコミットを足したブランチは先頭がどの PR にも含まれないので、マージ済みとみなさない
  if [[ -z "$merged" ]]; then
    if ! pr_merge_state "$repo" "$sha"; then
      add_problem "ブランチ $branch のマージを gh で確かめられない: ${REPLY:0:200}" "マージを gh で確かめられない"
      return
    fi
    case "$REPLY" in
      "merged "*) merged="PR #${REPLY#merged } がマージ済み" ;;
      "queued "*)
        number="${REPLY#queued }"
        add_problem "ブランチ $branch が未マージ（PR #$number が merge queue 中）" "merge queue 中"
        QUEUE_COUNT=$((QUEUE_COUNT + 1))
        QUEUE_PRS+="$repo"$'\t'"$number"$'\n'
        return
        ;;
      *)
        add_problem "ブランチ $branch が未マージ" "未マージ"
        return
        ;;
    esac
  fi
  WT_PATHS[WT_COUNT]="$top"
  WT_REPOS[WT_COUNT]="$repo"
  WT_BRANCHES[WT_COUNT]="$branch"
  WT_COUNT=$((WT_COUNT + 1))
  # 短い一覧では、worktree をフォルダの名前（thread が作る worktree なら <repo の名前>=tmp-<slug>）で示す
  add_action "worktree $top とブランチ $branch を消す（${merged}）" "worktree ${top##*/} とブランチ $branch を消す（${merged}）"
  MERGED_NOTES="${MERGED_NOTES:+$MERGED_NOTES / }ブランチ $branch は ${merged}"
}

judge_thread() { # <thread の id>
  local dir="$PROJECT_DIR/threads/$1" got rc report_status report_at="" status line successor
  local -a paths=()
  PROBLEMS="" PROBLEM_KINDS="" PROBLEM_COUNT=0 ACTIONS="" NOTES="" WT_COUNT=0 WT_PATHS=() WT_REPOS=() WT_BRANCHES=() WT_RECORDED=""
  QUEUE_COUNT=0 QUEUE_PRS="" MERGED_NOTES="" TERMINAL="" TERMINAL_STATE="" AWAITS_SUCCESSOR=""
  TERMINAL="$(jq -r '.terminal // empty' "$dir/thread.json")"
  successor="$(jq -r '.supersededBy // empty' "$dir/thread.json")"
  if [[ -n "$TERMINAL" ]]; then
    rc=0
    got="$(hc get "$TERMINAL" --json 2>/dev/null)" || rc=$?
    # 3 は not_found（再起動で消えた・rm 済み）。それ以外の失敗で状態が分からないまま消すと、作業中の thread を消しかねない
    if [[ $rc -eq 0 ]]; then
      TERMINAL_STATE="$(jq -r '.state' <<<"$got")"
    elif [[ $rc -ne 3 ]]; then
      add_problem "terminal $TERMINAL の状態を確かめられない（hc get が exit ${rc}）" "terminal の状態を確かめられない"
      return
    fi
  fi
  if [[ -n "$successor" ]]; then
    if [[ -f "$PROJECT_DIR/threads/$successor/thread.json" ]]; then
      add_problem "${successor} に引き継いだ（${successor} を片付けるときに一緒に片付ける）" "引き継ぎ先が残っている"
      AWAITS_SUCCESSOR=1
      return
    fi
  else
    if [[ ! -f "$dir/status.json" ]]; then
      add_problem "報告が無い" "報告が無い"
      return
    fi
    report_status="$(jq -r '.status' "$dir/status.json")"
    report_at="$(jq -r '.at' "$dir/status.json")"
    if [[ "$report_status" != "done" ]]; then
      add_problem "最後の報告が $report_status" "最後の報告が $report_status"
      return
    fi
  fi
  if [[ "$TERMINAL_STATE" == "live" ]]; then
    status="$(jq -r '.status.state // empty' <<<"$got")"
    case "$status" in
      working) add_problem "作業中" "作業中"; return ;;
      blocked) add_problem "許可待ち" "許可待ち"; return ;;
      error) add_problem "エラー" "エラー"; return ;;
    esac
    # message は送るときに報告のラベルを消す。ラベルの時刻が合わなければ、done の後に続きを頼まれている。
    # 引き継いだ thread には送らないので見ない
    if [[ -z "$successor" && "$(jq -r '.labels["report.at"] // empty' <<<"$got")" != "$report_at" ]]; then
      add_problem "done の報告の後に追加の依頼を受けている" "done の後に追加の依頼"
      return
    fi
  fi
  if [[ ! -f "$dir/worktrees.txt" ]]; then
    add_action "worktree の記録なし（thread だけ片付ける）" ""
    return
  fi
  # 先に読み切る。判定の中の git・gh・hc に worktrees.txt の残りを stdin として読ませない
  while read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then paths+=("$line"); fi
  done < "$dir/worktrees.txt"
  if [[ ${#paths[@]} -eq 0 ]]; then
    add_action "worktree の記録なし（thread だけ片付ける）" ""
    return
  fi
  WT_RECORDED=1
  for line in "${paths[@]}"; do judge_worktree "$line"; done
}

# --merged で、残す理由が merge queue 中の PR だけか（マージされれば消せるか）
queued_only() {
  [[ "$QUEUE_COUNT" -gt 0 && "$PROBLEM_COUNT" -eq "$QUEUE_COUNT" ]]
}

# --merged で、消せる判定の thread を消さない理由を残す理由（PROBLEMS）に足す。消してよければ失敗する。
# 取り込み済みを確かめた worktree が 1 つも無い thread は、マージと結び付けられない
merged_unconfirmed() {
  [[ "$WT_COUNT" -eq 0 ]] || return 1
  if [[ -n "$WT_RECORDED" ]]; then
    add_problem "記録した worktree がもう無く、マージを確かめられない" "記録した worktree がもう無くマージを確かめられない"
  else
    add_problem "worktree の記録が無く、マージを確かめられない" "worktree の記録が無くマージを確かめられない"
  fi
}

# 消せる thread だけ、一時フォルダを探して、消すものの説明に足す
judge() { # <thread の id>
  judge_thread "$1"
  SCRATCH="" SCRATCH_NOTE=""
  if [[ -n "$PROBLEMS" ]]; then return; fi
  judge_scratchpad "$1"
  if [[ -n "$SCRATCH" ]]; then
    add_action "Claude の一時フォルダ ${SCRATCH}（scratchpad など）を消す" ""
  elif [[ -n "$SCRATCH_NOTE" ]]; then
    add_action "Claude の一時フォルダは消さない（${SCRATCH_NOTE}）"
  fi
  judge_reports "$PROJECT_DIR/threads/$1"
  REPLY="$(reports_text "$DROP_COUNT" "$KEEP_COUNT")"
  if [[ -n "$REPLY" ]]; then add_action "$REPLY" ""; fi
  REPLY="$(predecessors_of "$1")"
  if [[ -n "$REPLY" ]]; then add_action "引き継ぎ元の ${REPLY//$'\n'/・} も一緒に片付ける"; fi
}

# この thread に引き継いだ thread（thread.json の supersededBy がこの id）の id を 1 行ずつ出す
predecessors_of() { # <thread の id>
  local file
  local -a files=()
  for file in "$PROJECT_DIR"/threads/t*/thread.json; do
    if [[ -f "$file" && "$file" =~ /threads/t[0-9]+/thread\.json$ ]]; then files+=("$file"); fi
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  jq -r --arg id "$1" 'select(.supersededBy == $id) | input_filename | rtrimstr("/thread.json") | split("/") | last' "${files[@]}"
}

terminal_text() {
  if [[ "$TERMINAL_STATE" == "live" ]]; then
    echo " / terminal $TERMINAL を終わらせる"
  fi
}

# worktree → ブランチ → terminal → 一時フォルダ → フォルダの順に片付ける。途中で失敗したら後の手順を行わずに thread を残し、もう一度試せるようにする。
# ただし一時フォルダを消しきれなくても、thread の片付けは続ける（一時フォルダは放っておいても数日で消える）。
# worktree は --force を付けず、変更が残っていれば git に断らせる。ブランチは取り込みを確かめた後なので -D で消す
# （-d は HEAD か upstream と比べるので、origin/main にだけ取り込まれたブランチを断る）
OUTCOME=""
remove_thread() { # <thread の id>
  local id="$1" out i deleted="$PROJECT_DIR/threads/.deleted" scratch_result=""
  for ((i = 0; i < WT_COUNT; i++)); do
    if ! out="$(git -C "${WT_REPOS[$i]}" worktree remove "${WT_PATHS[$i]}" 2>&1)"; then
      OUTCOME="残した: worktree ${WT_PATHS[$i]} を消せない: ${out:0:200}"
      return 1
    fi
    if ! out="$(git -C "${WT_REPOS[$i]}" branch -D "${WT_BRANCHES[$i]}" 2>&1)"; then
      OUTCOME="残した: ブランチ ${WT_BRANCHES[$i]} を消せない: ${out:0:200}"
      return 1
    fi
  done
  if [[ "$TERMINAL_STATE" == "live" ]] && ! out="$(hc kill "$TERMINAL" 2>&1)"; then
    OUTCOME="残した: terminal $TERMINAL を終わらせられない: ${out:0:200}"
    return 1
  fi
  if [[ -n "$TERMINAL_STATE" ]] && ! out="$(hc rm "$TERMINAL" 2>&1)"; then
    OUTCOME="残した: terminal $TERMINAL を消せない: ${out:0:200}"
    return 1
  fi
  # claude を終わらせた後に消す。hc rm は終わった terminal しか消さないので、ここでは claude はもう動いていない
  if [[ -n "$SCRATCH" ]]; then
    if ! out="$(rm -rf -- "$SCRATCH" 2>&1)"; then
      scratch_result=" / Claude の一時フォルダ $SCRATCH を消しきれない: ${out:0:200}"
    fi
  elif [[ -n "$SCRATCH_NOTE" ]]; then
    scratch_result=" / Claude の一時フォルダは消していない: $SCRATCH_NOTE"
  fi
  # 既にあると mv がその中へ入れてしまう
  if [[ -e "$deleted/$id" ]]; then
    OUTCOME="残した: $deleted/$id が既にあるので、フォルダを移せない"
    return 1
  fi
  mkdir -p "$deleted"
  mv "$PROJECT_DIR/threads/$id" "$deleted/$id"
  # 結果は短くするため、パスは project のフォルダからの形にし、一時フォルダは消せなかったときだけ書く
  OUTCOME="片付けた（report.md などは threads/.deleted/$id に残っています）$scratch_result"
}

thread_ids() {
  local dir
  for dir in "$PROJECT_DIR"/threads/t*; do
    if [[ -f "$dir/thread.json" && "$(basename "$dir")" =~ ^t[0-9]+$ ]]; then basename "$dir"; fi
  done
}

title_of() { jq -r '.title' "$PROJECT_DIR/threads/$1/thread.json"; }

# 結果の行は、要約の結果を足してから最後にまとめて出す。要約は裏で回し、結果を $SUMMARY_DIR/<行の番号> に書かせる
lines=()
# --handoff は、消した thread を id だけで出し、行は何かあったものだけを出す。消した thread の id と、
# 片付けて何も残らなかった行の番号（REMOVED_CLEANLY[<行の番号>]=1）を持つ
REMOVED_IDS=()
REMOVED_CLEANLY=()
pending=()
pending_dirs=() # pending と同じ並びで、要約する thread の（移した後の）フォルダ
running=0
SUMMARY_DIR=""

# 直前の一覧に無い id があれば断って終わる。あれば一覧を使い切り、要約の結果を置くフォルダを作る
take_listed() { # <id...>
  local id
  local -a unlisted=()
  for id in "$@"; do
    if [[ ! -f "$LISTED" ]] || ! grep -qxF -- "$id" "$LISTED"; then unlisted+=("$id"); fi
  done
  if [[ ${#unlisted[@]} -gt 0 ]]; then
    if [[ -n "$DELETED_MODE" ]]; then
      echo "直前の --deleted の一覧の「写しを減らせる」に無い id があります: ${unlisted[*]}。何も変えていません。--deleted だけで呼んで一覧を出し直し、user の承認を得てから呼び直してください。" >&2
    else
      echo "直前の一覧の「消せる」に無い id があります: ${unlisted[*]}。何も消していません。id を付けずに呼んで一覧を出し直し、user の承認を得てから呼び直してください。" >&2
    fi
    exit 1
  fi
  take_lock_or_exit
  # 一覧は 1 回にだけ使う。残ったものをやり直すときは一覧から出し直す
  rm -f "$LISTED"
  make_summary_dir
}

make_summary_dir() {
  SUMMARY_DIR="$(mktemp -d)"
}

# 消す呼び出しを project に 1 本ずつにする lock。mkdir で取り、中に持ち主の PID を書く。持ち主がもう動いていなければ
# （kill -9 などで残った）取り直す
LOCK_DIR="$PROJECT_DIR/cleanup.lock"
LOCK_HELD=""
# 引き継ぎの片付けは haiku の要約で数十秒〜2 分かかるので、それを待てる長さにする
LOCK_WAIT_SEC=180
on_exit() {
  if [[ -n "$SUMMARY_DIR" ]]; then rm -rf "$SUMMARY_DIR"; fi
  if [[ -n "$LOCK_HELD" ]]; then rm -rf "$LOCK_DIR"; fi
}
trap on_exit EXIT
# lock を取る。<待つ秒数> の間に取れなければ失敗する
take_lock() { # <待つ秒数>
  local deadline=$((SECONDS + $1)) owner
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner=""
    if [[ -f "$LOCK_DIR/pid" ]]; then read -r owner < "$LOCK_DIR/pid" || owner=""; fi
    # 作った直後で pid をまだ書いていない lock は、持ち主が動いているとみなす
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$LOCK_DIR"
      continue
    fi
    ((SECONDS < deadline)) || return 1
    /bin/sleep 1
  done
  LOCK_HELD=1
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}
# 待って取れなければ、何も消さずに終わる
take_lock_or_exit() {
  if ! take_lock "$LOCK_WAIT_SEC"; then
    echo "ほかの片付け（見張り・引き継ぎ・--merged など）が ${LOCK_WAIT_SEC} 秒たっても終わらないので、何も消していません。少し置いて同じコマンドを呼び直してください" >&2
    exit 1
  fi
}

# lines の最後の行の thread の要約を裏で回す。要約に渡すのは prune_reports が KEEPS に残した写し
start_summary() { # <thread のフォルダ> <thread の id> <題名>
  if [[ "$running" -ge "$SUMMARY_JOBS" ]]; then
    wait
    running=0
  fi
  summarize_thread "$1" "$2" "$3" "${KEEPS[@]}" > "$SUMMARY_DIR/$((${#lines[@]} - 1))" &
  pending+=($((${#lines[@]} - 1)))
  pending_dirs+=("$1")
  running=$((running + 1))
}

# judge で消せると判定した thread を消し、結果の行を lines に足して、要約が要れば裏で回す。消せなかったら失敗する。
# 前置きを渡すと、結果の行の先頭（「: 」の後）に置く。消せたら、この thread に引き継いだ thread も判定し直して消す
remove_and_record() { # <thread の id> <題名> [<前置き>]
  local moved="$DELETED_DIR/$1" head="${3:+$3 / }"
  if ! remove_thread "$1"; then
    lines+=("- ${1}「${2}」: ${head}$OUTCOME")
    return 1
  fi
  prune_reports "$moved"
  lines+=("- ${1}「${2}」: ${head}$OUTCOME${REPORTS_ERROR:+ / $REPORTS_ERROR}")
  REMOVED_IDS+=("$1")
  if [[ -z "$REPORTS_ERROR" ]]; then REMOVED_CLEANLY[${#lines[@]} - 1]=1; fi
  if [[ -n "$NEED_SUMMARY" ]]; then start_summary "$moved" "$1" "$2"; fi
  remove_predecessors "$1"
}

# 消した thread に引き継いだ thread を消す。引き継ぎ元の引き継ぎ元も、remove_and_record から順にたどる。
# 引き継ぎ元は作業中などで残すことがあり（user が手で再開した、など）、そのときは理由を行に出す。引き継ぎ先は消せているので失敗にしない
remove_predecessors() { # <消した thread の id>
  local id title
  for id in $(predecessors_of "$1"); do
    judge "$id"
    title="$(title_of "$id")"
    if [[ -n "$PROBLEMS" ]]; then
      lines+=("- ${id}「${title}」: 残した（引き継ぎ先 ${1} は片付けた）: $PROBLEMS")
    else
      remove_and_record "$id" "$title" "引き継ぎ先 ${1} と一緒に片付けた" || true
    fi
  done
}

# 要約を待ち、その結果を行に足して、すべての行を出す
print_lines() {
  local i
  wait
  for i in ${pending[@]+"${pending[@]}"}; do
    read_text "$SUMMARY_DIR/$i"
    REPLY="${REPLY:-要約の結果が分からない（報告の写しは残っているはず）}"
    # 写しを消さずに要約だけをした --deleted の行は「: 」で終わる
    if [[ "${lines[i]}" == *: ]]; then lines[i]+=" $REPLY"; else lines[i]+=" / $REPLY"; fi
  done
  if [[ ${#lines[@]} -eq 0 ]]; then echo "- なし"; else printf '%s\n' "${lines[@]}"; fi
}

# --- 回送の写し（relays/<回送 id>/）

# relay は、回送に添えたファイルを送り先の project の relays/<回送 id>/ に写し、受けた coordinator は thread の brief に
# 写しのパスを書く。台帳は持たず、brief.md から指されているかで使っているかを見る。届いてすぐは、thread を起動する前
# （user に報告して返事を待つ間など）なので消さない
RELAY_KEEP_DAYS=7
RELAY_RULE="届いてから ${RELAY_KEEP_DAYS} 日を過ぎ、片付けていない thread の brief.md に書かれていない"

# 消せる回送の写しの id を RELAY_DROPS に、件数を RELAY_DROP_COUNT に入れる。読めない brief.md があったら、写しを消さずに
# RELAY_NOTE に理由を入れる。thread の id を渡すと、その brief.md は見ない（一覧で、消せる thread を消した後を見積もる）
judge_relays() { # [<見ない thread の id>...]
  local dir id cutoff brief skip t rc
  local -a briefs=()
  RELAY_DROPS=()
  RELAY_DROP_COUNT=0
  RELAY_NOTE=""
  [[ -d "$PROJECT_DIR/relays" ]] || return 0
  for brief in "$PROJECT_DIR"/threads/t*/brief.md; do
    [[ -f "$brief" ]] || continue
    skip=""
    for t in "$@"; do
      if [[ "$brief" == "$PROJECT_DIR/threads/$t/brief.md" ]]; then skip=1; fi
    done
    [[ -n "$skip" ]] || briefs+=("$brief")
  done
  # 回送 id は UTC の時刻（YYYYmmddTHHMMSSZ）なので、文字の並びで比べられる
  cutoff="$(date -u -v-"${RELAY_KEEP_DAYS}"d +%Y%m%dT%H%M%SZ)"
  for dir in "$PROJECT_DIR"/relays/*; do
    id="${dir##*/}"
    [[ -d "$dir" && "$id" =~ ^[0-9]{8}T[0-9]{6}Z$ && "$id" < "$cutoff" ]] || continue
    if [[ ${#briefs[@]} -gt 0 ]]; then
      rc=0
      grep -qF -- "/relays/$id" "${briefs[@]}" 2>/dev/null || rc=$?
      if [[ "$rc" -eq 0 ]]; then continue; fi
      if [[ "$rc" -ne 1 ]]; then
        RELAY_NOTE="読めない brief.md があるので、回送の写しを消していない"
        RELAY_DROPS=()
        RELAY_DROP_COUNT=0
        return 0
      fi
    fi
    RELAY_DROPS+=("$id")
    RELAY_DROP_COUNT=$((RELAY_DROP_COUNT + 1))
  done
}

# judge_relays を判定し直して、消せる写しを消し、結果を 1 行で出す。id を渡すと、そのうちの消せるものだけを消す
# （一覧に出したものだけを消す）。消すものも理由も無ければ何も出さない
prune_relays() { # [<消してよい回送 id>...]
  local id a allowed out removed="" count=0 failed=""
  judge_relays
  for id in ${RELAY_DROPS[@]+"${RELAY_DROPS[@]}"}; do
    if [[ $# -gt 0 ]]; then
      allowed=""
      for a in "$@"; do
        if [[ "$a" == "$id" ]]; then allowed=1; fi
      done
      [[ -n "$allowed" ]] || continue
    fi
    if out="$(rm -rf -- "$PROJECT_DIR/relays/$id" 2>&1)"; then
      removed+="${removed:+, }relays/$id"
      count=$((count + 1))
    else
      failed+=" / relays/$id を消しきれない: ${out:0:200}"
    fi
  done
  if [[ "$count" -gt 0 ]]; then
    echo "回送の写しを消した（${count} 件。${RELAY_RULE}）: ${removed}${failed}"
  elif [[ -n "$failed" ]]; then
    echo "回送の写し:${failed# /}"
  fi
  if [[ -n "$RELAY_NOTE" ]]; then echo "回送の写し: $RELAY_NOTE"; fi
}

# --- 片付け済みの thread の写しを減らす

# 片付け済みの thread の写しを判定する。何もしないときは、その理由を DELETED_SKIP に入れる。
# summary.md があれば、写しが残っていても触らない（前に要約した写しを、別の要約で上書きしない）
judge_deleted() { # <thread のフォルダ>
  DELETED_SKIP=""
  if [[ -e "$1/summary.md" ]]; then
    DELETED_SKIP="summary.md がある"
    return
  fi
  judge_reports "$1"
  if [[ $((DROP_COUNT + KEEP_COUNT)) -eq 0 ]]; then
    DELETED_SKIP="写しが無い"
  elif [[ "$DROP_COUNT" -eq 0 && "$KEEP_COUNT" -lt 2 ]]; then
    DELETED_SKIP="写しが 1 つ"
  fi
}

deleted_ids() {
  local dir
  for dir in "$DELETED_DIR"/t*; do
    if [[ -d "$dir" && "$(basename "$dir")" =~ ^t[0-9]+$ ]]; then basename "$dir"; fi
  done
}

# 一覧と結果に出す「<id>「<題名>」」。thread.json が読めなければ id だけ
deleted_label() { # <thread の id>
  local title
  title="$(jq -r '.title // empty' "$DELETED_DIR/$1/thread.json" 2>/dev/null)" || title=""
  echo "${1}${title:+「${title}」}"
}

if [[ -n "$DELETED_MODE" && $# -eq 0 ]]; then
  listed=()
  listed_lines=()
  none=0 single=0 summarized=0
  for id in $(deleted_ids); do
    judge_deleted "$DELETED_DIR/$id"
    case "$DELETED_SKIP" in
      "写しが無い") none=$((none + 1)) ;;
      "写しが 1 つ") single=$((single + 1)) ;;
      "summary.md がある") summarized=$((summarized + 1)) ;;
      *)
        listed+=("$id")
        listed_lines+=("- $(deleted_label "$id"): $(reports_text "$DROP_COUNT" "$KEEP_COUNT")")
        ;;
    esac
  done
  echo "写しを減らせる片付け済みの thread（${#listed[@]} 件）:"
  if [[ ${#listed[@]} -eq 0 ]]; then echo "- なし"; else printf '%s\n' "${listed_lines[@]}"; fi
  echo "何もしない片付け済みの thread（$((none + single + summarized)) 件）: 写しが無い $none 件、写しが 1 つ $single 件、summary.md がある $summarized 件"
  if [[ ${#listed[@]} -eq 0 ]]; then
    rm -f "$LISTED"
  else
    printf '%s\n' "${listed[@]}" > "$LISTED"
    echo
    echo "まだ何も変えていません。この一覧を user に見せて承認を得てから、id を付けて呼び直してください（除外を頼まれた id は付けない）。"
  fi
  exit 0
fi

if [[ -n "$DELETED_MODE" ]]; then
  take_listed "$@"
  failed=0
  for id in "$@"; do
    dir="$DELETED_DIR/$id"
    if [[ ! -d "$dir" ]]; then
      lines+=("- $id: 片付け済みの thread に見つからない")
      failed=1
      continue
    fi
    label="$(deleted_label "$id")"
    # 一覧を出してから、別の呼び出しが要約を作っていることがあるので、判定し直す
    judge_deleted "$dir"
    if [[ -n "$DELETED_SKIP" ]]; then
      lines+=("- ${label}: 何もしなかった（${DELETED_SKIP}）")
      continue
    fi
    prune_reports "$dir"
    lines+=("- ${label}:${REPORTS_RESULT:+ $REPORTS_RESULT}")
    if [[ -n "$NEED_SUMMARY" ]]; then
      start_summary "$dir" "$id" "$(jq -r '.title // empty' "$dir/thread.json" 2>/dev/null || true)"
    fi
  done
  print_lines
  [[ "$failed" -eq 0 ]]
  exit
fi

# --- マージ後の片付け（--merged・--pr-merged）

# 見張りの知らせの目印。--merged の出力でも、どの入力で結果が届くかを示すのに使う（bin/pr-watch と同じ）
PR_TAG="[project-threads pr]"

# この project の見張り（bin/watch）が動いているか。watch.pid の PID が、この project の見張りのプロセスかを ps で確かめる
# （見張りが止まった後に PID がほかのプロセスに使い回されることがある）
watch_running() {
  local pid="" command
  if [[ -f "$PROJECT_DIR/watch.pid" ]]; then read -r pid < "$PROJECT_DIR/watch.pid" || pid=""; fi
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && command="$(ps -o command= -p "$pid")" &&
    [[ "$command" == *"/bin/watch "* ]]
}

# merge queue 中の PR（QUEUE_PRS の形）を、thread の prs.json に「マージされたら片付ける」印（cleanupOnMerge）つきで書く。
# 見張りは番号で PR を見て（state が無いので終わっていない PR として扱う）、マージを確かめたら --pr-merged を呼ぶ。
# コミットから見つけた PR は thread のブランチの PR でないこともある（統合ブランチに入った agent slot のブランチなど）ので、番号で書く
mark_cleanup_on_merge() { # <thread の id> <QUEUE_PRS>
  local file="$PROJECT_DIR/threads/$1/prs.json" repo number entries="[]" updated
  while IFS=$'\t' read -r repo number; do
    [[ -n "$repo" ]] || continue
    entries="$(jq -c --arg repo "$repo" --argjson number "$number" '. + [{repo: $repo, number: $number}]' <<<"$entries")"
  done <<<"$2"
  if [[ -f "$file" ]]; then updated="$(cat "$file")"; else updated='{"prs": []}'; fi
  updated="$(jq --argjson add "$entries" '
    reduce $add[] as $a (.;
      (.prs | map(.repo == $a.repo and .number == $a.number) | index(true)) as $i
      | if $i == null then .prs += [$a + {cleanupOnMerge: true}] else .prs[$i].cleanupOnMerge = true end)' <<<"$updated")"
  printf '%s\n' "$updated" > "$file.tmp"
  mv "$file.tmp" "$file"
}

# 見張りが、--merged で merge queue 中だった PR のマージを確かめたときに呼ぶ。渡した thread だけを --merged と同じ判定で消し、
# 結果の行を 1 行で出す
if [[ "$MERGED_MODE" == pr ]]; then
  id="$1"
  if [[ ! "$id" =~ ^t[0-9]+$ || ! -f "$PROJECT_DIR/threads/$id/thread.json" ]]; then
    echo "- ${id}: 見つからないか、片付け済み"
    exit 1
  fi
  take_lock 0 || exit 75
  make_summary_dir
  judge "$id"
  title="$(title_of "$id")"
  rc=0
  if [[ -n "$PROBLEMS" ]]; then
    lines+=("- ${id}「${title}」: 残した: $PROBLEMS")
    # マージの直後は、GitHub がコミットの PR（associatedPullRequests）にまだ反映していないことがある。理由がそれでありうるものだけなら試し直させる
    rc=3
    while IFS= read -r kind; do
      case "$kind" in "未マージ" | "マージを gh で確かめられない" | "merge queue 中") ;; *) rc=1 ;; esac
    done <<<"$PROBLEM_KINDS"
  elif merged_unconfirmed; then
    lines+=("- ${id}「${title}」: 残した: $PROBLEMS")
    rc=1
  elif ! remove_and_record "$id" "$title" "$MERGED_NOTES"; then
    rc=1
  fi
  # 要約はこのシェルの子なので、ここで待つ（print_lines は $(...) の中で動き、このシェルの子を待てない）
  wait
  text="$(print_lines)"
  # 見張りが知らせの 1 行に入れるので、改行を区切りに替える
  printf '%s\n' "${text//$'\n'/ / }"
  exit "$rc"
fi

if [[ "$MERGED_MODE" == 1 ]]; then
  take_lock_or_exit
  make_summary_dir
  waiting=()
  waiting_lines=()
  kept_count=0
  # 引き継ぎ先が残っているので残す thread。後で引き継ぎ先と一緒に消えたものは、残す thread に出さない
  superseded_ids=()
  superseded_kinds=()
  failed=0
  for id in $(thread_ids); do
    # 先に判定した引き継ぎ先と一緒に消した thread
    [[ -f "$PROJECT_DIR/threads/$id/thread.json" ]] || continue
    judge "$id"
    title="$(title_of "$id")"
    if [[ -n "$PROBLEMS" ]]; then
      if [[ -n "$AWAITS_SUCCESSOR" ]]; then
        superseded_ids+=("$id")
        superseded_kinds+=("$PROBLEM_KINDS")
      elif queued_only; then
        waiting+=("$id")
        waiting_lines+=("- ${id}「${title}」: $PROBLEMS")
        mark_cleanup_on_merge "$id" "$QUEUE_PRS"
      else
        group_kinds "$id" "$PROBLEM_KINDS"
        kept_count=$((kept_count + 1))
      fi
    elif merged_unconfirmed; then
      group_kinds "$id" "$PROBLEM_KINDS"
      kept_count=$((kept_count + 1))
    elif ! remove_and_record "$id" "$title" "$MERGED_NOTES"; then
      failed=1
    fi
  done
  for ((i = 0; i < ${#superseded_ids[@]}; i++)); do
    if [[ -f "$PROJECT_DIR/threads/${superseded_ids[i]}/thread.json" ]]; then
      group_kinds "${superseded_ids[i]}" "${superseded_kinds[i]}"
      kept_count=$((kept_count + 1))
    fi
  done
  wait_note=""
  if [[ ${#waiting[@]} -gt 0 ]]; then
    # 見張りは coordinator と同じ寿命で、止まっていた間のマージも次に開いたときに拾う。いま動いていなければ、それを伝える
    if watch_running; then
      wait_note="マージされたら見張りが片付けて、結果を「${PR_TAG}」で始まる入力で送ります"
    else
      wait_note="見張りが動いていないので、coordinator を開き直すまで片付けません。急ぐなら、マージされた後に、もう一度 --merged で呼んでください"
    fi
  fi
  echo "マージを確かめた thread（${#lines[@]} 件）:"
  print_lines
  if [[ ${#waiting[@]} -gt 0 ]]; then
    echo "merge queue の PR を待つ thread（${#waiting[@]} 件）: $wait_note"
    printf '%s\n' "${waiting_lines[@]}"
  fi
  print_kept_kinds "$kept_count"
  prune_relays
  [[ "$failed" -eq 0 ]]
  exit
fi

# --- 引き継ぎのときの片付け（--handoff）

if [[ -n "$HANDOFF_MODE" ]]; then
  progress="$PROJECT_DIR/memory/progress.md"
  if [[ ! -f "$progress" ]]; then
    echo "$progress が無いので、残す thread が分からず、何も片付けていません" >&2
    exit 1
  fi
  take_lock_or_exit
  # /clear の後の会話は前の一覧を知らないので、一覧の id で消させない
  rm -f "$LISTED"
  make_summary_dir
  # progress の「動いている thread」の節に出てくる id（t と数字だけの語。terminal の t5b などを拾わない）と、
  # progress より後に status.json を書いた thread の id
  keep="$(
    LC_ALL=C awk '/^## /{on = ($0 ~ /^## 動いている thread[[:space:]]*$/)} on' "$progress" | LC_ALL=C tr -c 'A-Za-z0-9_' '\n' | grep -xE 't[0-9]+' || true
    find "$PROJECT_DIR/threads" -mindepth 2 -maxdepth 2 -name status.json -newer "$progress" | awk -F/ '{print $(NF - 1)}'
  )"
  kept_ids=()
  kept_count=0
  superseded_ids=()
  superseded_kinds=()
  failed=0
  for id in $(thread_ids); do
    # 先に判定した引き継ぎ先と一緒に消した thread
    [[ -f "$PROJECT_DIR/threads/$id/thread.json" ]] || continue
    judge "$id"
    if [[ -n "$PROBLEMS" ]]; then
      if [[ -n "$AWAITS_SUCCESSOR" ]]; then
        superseded_ids+=("$id")
        superseded_kinds+=("$PROBLEM_KINDS")
      else
        group_kinds "$id" "$PROBLEM_KINDS"
        kept_count=$((kept_count + 1))
      fi
    elif [[ $'\n'"$keep"$'\n' == *$'\n'"$id"$'\n'* ]]; then
      kept_ids+=("$id")
    elif ! remove_and_record "$id" "$(title_of "$id")"; then
      failed=1
    fi
  done
  for ((i = 0; i < ${#superseded_ids[@]}; i++)); do
    if [[ -f "$PROJECT_DIR/threads/${superseded_ids[i]}/thread.json" ]]; then
      group_kinds "${superseded_ids[i]}" "${superseded_kinds[i]}"
      kept_count=$((kept_count + 1))
    fi
  done
  wait
  unsummarized=""
  for ((i = 0; i < ${#pending_dirs[@]}; i++)); do
    if [[ ! -s "${pending_dirs[i]}/summary.md" ]]; then unsummarized+="${unsummarized:+・}${pending_dirs[i]##*/}"; fi
  done
  text=""
  for id in ${REMOVED_IDS[@]+"${REMOVED_IDS[@]}"}; do text+="${text:+・}$id"; done
  echo "引き継ぎで片付けた thread（${#REMOVED_IDS[@]} 件。report.md などは threads/.deleted/<id> に残っています）: ${text:-なし}"
  if [[ ${#kept_ids[@]} -gt 0 ]]; then
    text=""
    for id in "${kept_ids[@]}"; do text+="${text:+・}$id"; done
    echo "消せるが、progress の「動いている thread」にあるか、progress の後に報告したので残した thread（${#kept_ids[@]} 件）: $text"
  fi
  if [[ "$kept_count" -gt 0 ]]; then
    text=""
    for ((i = 0; i < ${#KIND_NAMES[@]}; i++)); do text+="${text:+ / }${KIND_NAMES[i]} ${KIND_IDS[i]}"; done
    echo "消せないので残した thread（${kept_count} 件）: $text"
  fi
  # 片付けられなかった thread・報告の写しを消しきれなかった thread・引き継ぎ先と一緒に消さずに残した引き継ぎ元
  text=""
  for ((i = 0; i < ${#lines[@]}; i++)); do
    if [[ -z "${REMOVED_CLEANLY[i]:-}" ]]; then text+="${lines[i]}"$'\n'; fi
  done
  if [[ -n "$text" ]]; then
    echo "片付けの途中で残したもの（threads/ か threads/.deleted/ に残っています。理由を user に 1 行で伝えてください）:"
    printf '%s' "$text"
  fi
  if [[ -n "$unsummarized" ]]; then
    echo "報告の写しを要約できなかった thread（写しは消さずに残しています。対応は要りません）: $unsummarized"
  fi
  prune_relays
  [[ "$failed" -eq 0 ]]
  exit
fi

# --- 一覧だけを出す

if [[ $# -eq 0 ]]; then
  deletable=()
  deletable_lines=()
  kept_lines=()
  for id in $(thread_ids); do
    judge "$id"
    if [[ -z "$PROBLEMS" ]]; then
      deletable+=("$id")
      if [[ -n "$VERBOSE" ]]; then
        deletable_lines+=("- ${id}「$(title_of "$id")」: $ACTIONS$(terminal_text)")
      else
        deletable_lines+=("- ${id}「$(title_of "$id")」${NOTES:+: $NOTES}")
      fi
    else
      kept_lines+=("- ${id}「$(title_of "$id")」: $PROBLEMS")
      group_kinds "$id" "$PROBLEM_KINDS"
    fi
  done
  echo "消せる thread（${#deletable[@]} 件）:"
  if [[ ${#deletable[@]} -eq 0 ]]; then echo "- なし"; else printf '%s\n' "${deletable_lines[@]}"; fi
  if [[ -n "$VERBOSE" ]]; then
    echo "残す thread（${#kept_lines[@]} 件）:"
    if [[ ${#kept_lines[@]} -eq 0 ]]; then echo "- なし"; else printf '%s\n' "${kept_lines[@]}"; fi
  else
    print_kept_kinds "${#kept_lines[@]}"
  fi
  if [[ ${#deletable[@]} -eq 0 ]]; then
    rm -f "$LISTED"
  else
    # 回送の写しは thread を消す回にだけ消すので、消せる thread があるときだけ出す。消す回は、ここに載せた写しだけを消す
    judge_relays "${deletable[@]}"
    relay_lines=()
    relay_text=""
    for id in ${RELAY_DROPS[@]+"${RELAY_DROPS[@]}"}; do
      relay_lines+=("relays/$id")
      relay_text+="${relay_text:+, }relays/$id"
    done
    if [[ "$RELAY_DROP_COUNT" -gt 0 ]]; then
      echo "一緒に消す回送の写し（${RELAY_DROP_COUNT} 件。${RELAY_RULE}）: $relay_text"
    fi
    if [[ -n "$RELAY_NOTE" ]]; then echo "回送の写し: $RELAY_NOTE"; fi
    printf '%s\n' "${deletable[@]}" ${relay_lines[@]+"${relay_lines[@]}"} > "$LISTED"
    echo
    echo "まだ何も消していません。この一覧を user に見せて承認を得てから、消す id を付けて呼び直してください（除外を頼まれた id は付けない）。"
  fi
  exit 0
fi

# --- 消す

# 一覧に載せた回送の写し。take_listed が一覧を消す前に読む
listed_relays=()
if [[ -f "$LISTED" ]]; then
  while IFS= read -r entry; do
    if [[ "$entry" == relays/* ]]; then listed_relays+=("${entry#relays/}"); fi
  done < "$LISTED"
fi
take_listed "$@"
failed=0
for id in "$@"; do
  if [[ ! -f "$PROJECT_DIR/threads/$id/thread.json" ]]; then
    lines+=("- $id: 見つからないか、片付け済み")
    failed=1
    continue
  fi
  # 一覧を出してから状況が変わっていることがある（追加の依頼で動き出した・コミットが増えた）ので、消す直前に判定し直す
  judge "$id"
  title="$(title_of "$id")"
  if [[ -n "$PROBLEMS" ]]; then
    lines+=("- ${id}「${title}」: 残した: $PROBLEMS")
    failed=1
  elif ! remove_and_record "$id" "$title"; then
    failed=1
  fi
done
print_lines
if [[ ${#listed_relays[@]} -gt 0 ]]; then prune_relays "${listed_relays[@]}"; fi
[[ "$failed" -eq 0 ]]
