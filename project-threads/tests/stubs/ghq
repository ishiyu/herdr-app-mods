#!/usr/bin/env bash
# テスト用の ghq。root（--all を含む）だけに答え、$STUB_STATE/ghq-roots の行を返す。無ければ何も返さない。
# run.sh が source して関数として export する（理由は stubs/hc の先頭）
ghq() (
  set -euo pipefail
  stub_log ghq "$@"
  if [[ "${1:-}" != "root" ]]; then
    echo "stub ghq: 知らないコマンド $*" >&2
    exit 2
  fi
  if [[ -f "$STUB_STATE/ghq-roots" ]]; then
    stub_cat "$STUB_STATE/ghq-roots"
  fi
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # shellcheck source=SCRIPTDIR/_lib.sh
  source "${0%/*}/_lib.sh"
  ghq "$@"
fi
