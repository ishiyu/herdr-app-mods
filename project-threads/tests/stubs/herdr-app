#!/usr/bin/env bash
# テスト用の herdr-app。呼ばれた引数を $STUB_LOG に記録する。
#   ls.json   herdr-app ls の応答
#   close-ok  あれば pane.close が成功する（無ければ「もう無い pane」として失敗する）
# run.sh が source して関数として export する（理由は stubs/hc の先頭）
# shellcheck disable=SC1010  # do は herdr-app のサブコマンドで、シェルの do ではない
herdr-app() (
  set -euo pipefail
  stub_log herdr-app "$@"

  case "$1 ${2:-}" in
    "ls ") stub_cat "$STUB_STATE/ls.json" ;;
    "do pane.split") echo '{"pane":"pLIST"}' ;;
    "do pane.focus") echo '{"ok":true}' ;;
    "do pane.close")
      if [[ ! -f "$STUB_STATE/close-ok" ]]; then
        echo '{"error":"no such pane"}'
        exit 1
      fi
      echo '{"ok":true}'
      ;;
    *)
      echo "stub herdr-app: 知らないコマンド $*" >&2
      exit 2
      ;;
  esac
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # shellcheck source=SCRIPTDIR/_lib.sh
  source "${0%/*}/_lib.sh"
  herdr-app "$@"
fi
