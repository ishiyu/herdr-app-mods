#!/usr/bin/env bash
# テスト用の gh。呼ばれた引数を $STUB_LOG に記録し、$STUB_STATE のファイルで応答を決める。
#   gh-prs.json  gh pr list の応答。無ければ []
#   gh-fails     あれば gh が失敗する
# run.sh が source して関数として export する（理由は stubs/hc の先頭）
gh() (
  set -euo pipefail
  stub_log gh "$@"

  if [[ -f "$STUB_STATE/gh-fails" ]]; then
    echo "gh: not logged in" >&2
    exit 1
  fi
  case "$1 ${2:-}" in
    "pr list")
      if [[ -f "$STUB_STATE/gh-prs.json" ]]; then stub_cat "$STUB_STATE/gh-prs.json"; else echo '[]'; fi
      ;;
    *)
      echo "stub gh: 知らないコマンド $*" >&2
      exit 2
      ;;
  esac
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # shellcheck source=SCRIPTDIR/_lib.sh
  source "${0%/*}/_lib.sh"
  gh "$@"
fi
