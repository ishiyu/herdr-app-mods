#!/usr/bin/env bash
# テスト用の gh。呼ばれた引数を $STUB_LOG に記録し、$STUB_STATE のファイルで応答を決める。
#   gh-prs.json  gh api graphql（cleanup のマージの確かめ）が引く PR の表。無ければ []。1 件は
#                {"number": 12, "headRefOid": "<sha>", "state": "MERGED", "isInMergeQueue": false, "commits": ["<sha>", ...], "mentions": ["<sha>", ...]}
#                で、commits を省くと headRefOid だけを含む。mentions は本文やコメントに書かれているだけの SHA。
#                -f oid=<コミット> の問い合わせには、そのコミットを commits に含む PR（associatedPullRequests）を返す。
#                -F q=<… SHA> の問い合わせ（PR の検索）には、本物と同じく SHA を commits か mentions に持つ PR を返す
#                （cleanup が検索に戻ると、言及だけの PR をマージ済みと誤ることをテストで捕まえるため）。
#                -F number=<番号> の問い合わせにはその PR の状態を返す。
#                bin/pr-watch の問い合わせ（-f v<k>=<ブランチ>・-F v<k>=<番号>）には、別名 v<k> ごとに、headRefName が
#                ブランチの PR（表の後ろほど新しい。最も新しい 1 件を nodes に）か、番号の PR を返す。PR には "headRefName"・"url"・
#                "checks"（statusCheckRollup の state）を足せる
#                -F u=<umbrella の番号> があれば（thread の外の PR を探す問い合わせ）、viewer・umbrella の sub-issue（gh-umbrella.json）・
#                表の OPEN の PR（u・o の別名）も返す。PR には "author"（無ければ me）・"closes"（closes する issue の番号の配列）・
#                "draft" を足せる
#   gh-umbrella.json  umbrella の sub-issue。[{"number": 10, "subIssues": [11, 12]}, ...]。無ければ []
#   gh-viewer    gh にログインしているアカウント。無ければ me
#   gh-fails     あれば gh が失敗する
#   gh-issue-title  gh issue view の応答（issue の題名）。無ければ「issue が無い」として失敗する
#   gh-repo      gh repo view の応答（owner/name）。呼ばれた作業フォルダを gh-repo-cwd に書く
# run.sh が source して関数として export する（理由は stubs/hc の先頭）
gh() (
  set -euo pipefail
  stub_log gh "$@"

  if [[ -f "$STUB_STATE/gh-fails" ]]; then
    echo "gh: not logged in" >&2
    exit 1
  fi
  case "$1 ${2:-}" in
    "api graphql")
      oid="" q="" number="" vars="" prev="" umbrella=""
      for arg in "$@"; do
        case "$arg" in
          u=*) umbrella="${arg#u=}" ;;
          oid=*) oid="${arg#oid=}" ;;
          q=*) q="${arg#q=}" ;;
          number=*) number="${arg#number=}" ;;
          v[0-9]*=*)
            if [[ "$prev" == -f ]]; then vars+="b $arg"$'\n'; else vars+="p $arg"$'\n'; fi
            ;;
        esac
        prev="$arg"
      done
      prs='[]'
      if [[ -f "$STUB_STATE/gh-prs.json" ]]; then prs="$(stub_cat "$STUB_STATE/gh-prs.json")"; fi
      if [[ -n "$vars" || -n "$umbrella" ]]; then
        family='[]' viewer=me
        if [[ -f "$STUB_STATE/gh-umbrella.json" ]]; then family="$(stub_cat "$STUB_STATE/gh-umbrella.json")"; fi
        if [[ -f "$STUB_STATE/gh-viewer" ]]; then viewer="$(stub_cat "$STUB_STATE/gh-viewer")"; fi
        jq -c --arg vars "$vars" --arg umbrella "$umbrella" --argjson family "$family" --arg viewer "$viewer" '. as $prs
          | def shape: {number, url, state, isInMergeQueue, headRefName,
              commits: {nodes: [{commit: {statusCheckRollup: (if .checks then {state: .checks} else null end)}}]}};
          def page: {pageInfo: {hasNextPage: false}};
          ($vars | split("\n") | map(select(. != "")
            | capture("^(?<k>[bp]) (?<a>v[0-9]+)=(?<v>.*)$")
            | {key: .a, value: (if .k == "b" then .v as $b | {nodes: [[$prs[] | select(.headRefName == $b)] | last // empty | shape]}
                else (.v | tonumber) as $n | (first($prs[] | select(.number == $n)) | shape) // null end)})
            | from_entries) as $repository
          | if $umbrella == "" then {data: {repository: $repository}}
            else {data: {viewer: {login: $viewer}, repository: ($repository + {
              u: {subIssues: (page + {nodes: [$family[] | {number, subIssues: (page + {nodes: [.subIssues[]? | {number: .}]})}]})},
              o: (page + {nodes: [$prs[] | select(.state == "OPEN") | shape + {isDraft: (.draft // false),
                author: {login: (.author // "me")}, closingIssuesReferences: {nodes: [.closes[]? | {number: .}]}}]})})}} end' <<<"$prs"
      elif [[ -n "$number" ]]; then
        jq -c --argjson n "$number" \
          '{data: {repository: {pullRequest: (first(.[] | select(.number == $n) | {state, isInMergeQueue}) // null)}}}' <<<"$prs"
      elif [[ -n "$oid" ]]; then
        jq -c --arg sha "$oid" '[.[] | select((.commits // [.headRefOid]) | index($sha)) | {number, state, isInMergeQueue}]
          | {data: {repository: {object: {associatedPullRequests: {nodes: .}}}}}' <<<"$prs"
      else
        jq -c --arg sha "${q##* }" '{data: {search: {nodes: [.[]
          | select(((.commits // [.headRefOid]) + (.mentions // [])) | index($sha))
          | {number, state, isInMergeQueue, repository: {nameWithOwner: "stub/repo"}}]}}}' <<<"$prs"
      fi
      ;;
    "issue view")
      if [[ ! -f "$STUB_STATE/gh-issue-title" ]]; then
        echo "GraphQL: Could not resolve to an issue or pull request" >&2
        exit 1
      fi
      stub_cat "$STUB_STATE/gh-issue-title"
      ;;
    "repo view")
      printf '%s\n' "$PWD" > "$STUB_STATE/gh-repo-cwd"
      stub_cat "$STUB_STATE/gh-repo"
      ;;
    *)
      echo "stub gh: 知らないコマンド $*" >&2
      exit 2
      ;;
  esac
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # shellcheck source=SCRIPTDIR/_lib.sh
  source "${0%/*}/_lib.sh"
  gh "$@"
fi
