#!/usr/bin/env bash
# テスト用の hc。呼ばれた引数を $STUB_LOG に記録し、$STUB_STATE のファイルで応答を決める。
#   get-<terminal>.json  hc get の応答。無ければ not_found（終了コード 3）
#   next-address         hc run が返す terminal の番号
#   run-fails            あれば hc run が失敗する
#   run-dialog           あれば、起動した terminal が状態を報告せず、会話の記録も書かない（信頼確認のダイアログで止まった形）
#   run-silent           あれば、起動した terminal が状態を報告しないが、最初のメッセージを会話の記録
#                        （$CLAUDE_CONFIG_DIR/projects/stub/<会話の id>.jsonl）に書く（通知を出さずに動いている形）
#   send-fails           あれば hc send が失敗する
#   get-error            あれば hc get が not_found 以外の理由で失敗する（終了コード 1）
#   kill-fails           あれば hc kill が失敗する
#   wait-states          hc wait のたびに先頭の 1 行を取り出し、待った terminal の status.state にする
#   read-screen          hc read が出す画面。無ければ信頼確認のダイアログの画面の代わりの 1 行
# send は送り手の HC_TERMINAL_ID を ["send-from", ...] の 1 行で記録に足す
# kill は get-<terminal>.json の state を finished に、rm は live でなければ get-<terminal>.json を消す。
# label は get-<terminal>.json の labels に書く（値が空なら消す）
#
# run.sh はこのファイルを source して、hc を関数として export する。bin/ のスクリプトは PATH より先に関数を使うので、
# 呼び出しのたびに env・bash を起動しない。本体を ( ) で囲むのは、exit と set -e を呼び出し側に漏らさないため
hc() (
  set -euo pipefail
  stub_log hc "$@"

  cmd="$1"
  shift
  case "$cmd" in
    get)
      if [[ -f "$STUB_STATE/get-error" ]]; then
        echo "connection refused" >&2
        exit 1
      fi
      if [[ ! -f "$STUB_STATE/get-$1.json" ]]; then
        echo '{"error":{"kind":"not_found"}}'
        exit 3
      fi
      stub_cat "$STUB_STATE/get-$1.json"
      ;;
    run)
      if [[ -f "$STUB_STATE/run-fails" ]]; then
        echo "spawn_failed" >&2
        exit 1
      fi
      cwd=""
      argv=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --cwd) cwd="$2"; shift 2 ;;
          --) shift; argv=("$@"); break ;;
          *) shift ;;
        esac
      done
      read -r address < "$STUB_STATE/next-address"
      # open が起動する見張りは、thread の番号と重ならないようにする
      if [[ "${argv[0]}" == */bin/watch ]]; then address=t0w; fi
      status='{"app":"claude-code","state":"working"}'
      if [[ -f "$STUB_STATE/run-dialog" ]]; then status=null; fi
      if [[ -f "$STUB_STATE/run-silent" ]]; then
        status=null
        session=""
        for ((i = 0; i < ${#argv[@]}; i++)); do
          if [[ "${argv[i]}" == "--session-id" || "${argv[i]}" == "--resume" ]]; then session="${argv[i + 1]}"; fi
        done
        mkdir -p "$CLAUDE_CONFIG_DIR/projects/stub"
        # 本物もメッセージの前にほかの行を書く
        stub_json_string "${argv[${#argv[@]} - 1]}"
        printf '{"type":"mode"}\n{"type":"user","message":{"role":"user","content":%s}}\n' "$REPLY" \
          >> "$CLAUDE_CONFIG_DIR/projects/stub/$session.jsonl"
      fi
      stub_json_string "$cwd"
      cwd_json="$REPLY"
      stub_json_array "${argv[@]}"
      printf '{"address":"%s","state":"live","cwd":%s,"status":%s,"foreground":{"argv":%s,"cwd":%s}}\n' \
        "$address" "$cwd_json" "$status" "$REPLY" "$cwd_json" > "$STUB_STATE/get-$address.json"
      printf '{"address":"%s"}\n' "$address"
      ;;
    read)
      if [[ -f "$STUB_STATE/read-screen" ]]; then stub_cat "$STUB_STATE/read-screen"; else echo "TRUST DIALOG SCREEN"; fi
      ;;
    keys) ;;
    wait)
      # wait-states の先頭の行を取り出し、get-<terminal>.json の status.state にする（ターンが進んだ形）
      if [[ -s "$STUB_STATE/wait-states" && -f "$STUB_STATE/get-$1.json" ]]; then
        rest=()
        { read -r next; while IFS= read -r line; do rest+=("$line"); done; } < "$STUB_STATE/wait-states"
        if [[ ${#rest[@]} -gt 0 ]]; then printf '%s\n' "${rest[@]}" > "$STUB_STATE/wait-states"; else : > "$STUB_STATE/wait-states"; fi
        got="$(jq --arg state "$next" '.status = {app: "claude-code", state: $state}' "$STUB_STATE/get-$1.json")"
        printf '%s\n' "$got" > "$STUB_STATE/get-$1.json"
      fi
      ;;
    send)
      # 本物は HC_TERMINAL_ID があると、相手が agent なら本文を <hc from="..."> で囲む。送り手の terminal を記録する
      stub_log send-from "${HC_TERMINAL_ID:-}"
      if [[ -f "$STUB_STATE/send-fails" ]]; then
        echo "refused" >&2
        exit 1
      fi
      ;;
    kill)
      if [[ -f "$STUB_STATE/kill-fails" ]]; then
        echo '{"error":{"kind":"io"}}'
        exit 1
      fi
      if [[ -f "$STUB_STATE/get-$1.json" ]]; then
        got="$(jq '.state = "finished"' "$STUB_STATE/get-$1.json")"
        printf '%s\n' "$got" > "$STUB_STATE/get-$1.json"
      fi
      ;;
    rm)
      if [[ ! -f "$STUB_STATE/get-$1.json" ]]; then
        echo '{"error":{"kind":"not_found"}}'
        exit 3
      fi
      if [[ "$(jq -r .state "$STUB_STATE/get-$1.json")" == "live" ]]; then
        echo '{"error":{"kind":"still_running"}}'
        exit 1
      fi
      rm "$STUB_STATE/get-$1.json"
      ;;
    label)
      terminal="$1"
      shift
      if [[ -f "$STUB_STATE/get-$terminal.json" ]]; then
        got="$(jq '
          reduce ($ARGS.positional[] | {k: sub("=.*"; ""; "s"), v: sub("^[^=]*="; ""; "s")}) as $p (.;
            if $p.v == "" then del(.labels[$p.k]) else .labels[$p.k] = $p.v end)
        ' "$STUB_STATE/get-$terminal.json" --args -- "$@")"
        printf '%s\n' "$got" > "$STUB_STATE/get-$terminal.json"
      fi
      # 本物は terminal の JSON を stdout に出す
      printf '{"address":"%s"}\n' "$terminal"
      ;;
    *)
      echo "stub hc: 知らないコマンド $cmd" >&2
      exit 2
      ;;
  esac
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # shellcheck source=SCRIPTDIR/_lib.sh
  source "${0%/*}/_lib.sh"
  hc "$@"
fi
