#!/usr/bin/env bash
# テスト用の hc。呼ばれた引数を $STUB_LOG に記録し、$STUB_STATE のファイルで応答を決める。
#   get-<terminal>.json  hc get の応答。無ければ not_found（終了コード 3）
#   next-address         hc run が返す terminal の番号
#   run-fails            あれば hc run が失敗する
#   run-dialog           あれば、起動した terminal が状態を報告せず、会話の記録も書かない（信頼確認のダイアログで止まった形）
#   run-silent           あれば、起動した terminal が状態を報告しないが、最初のメッセージを会話の記録
#                        （$CLAUDE_CONFIG_DIR/projects/stub/<会話の id>.jsonl）に書く（通知を出さずに動いている形）
#   send-fails           あれば hc send が失敗する
#   get-error            あれば hc get が not_found 以外の理由で失敗する（終了コード 1）
# kill は get-<terminal>.json の state を finished に、rm は live でなければ get-<terminal>.json を消す。
# label は get-<terminal>.json の labels に書く（値が空なら消す）
set -euo pipefail
jq -cn '["hc"] + $ARGS.positional' --args -- "$@" >> "$STUB_LOG"

cmd="$1"
shift
case "$cmd" in
  get)
    if [[ -f "$STUB_STATE/get-error" ]]; then
      echo "connection refused" >&2
      exit 1
    fi
    if [[ ! -f "$STUB_STATE/get-$1.json" ]]; then
      echo '{"error":{"kind":"not_found"}}'
      exit 3
    fi
    cat "$STUB_STATE/get-$1.json"
    ;;
  run)
    if [[ -f "$STUB_STATE/run-fails" ]]; then
      echo "spawn_failed" >&2
      exit 1
    fi
    cwd=""
    argv=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cwd) cwd="$2"; shift 2 ;;
        --) shift; argv=("$@"); break ;;
        *) shift ;;
      esac
    done
    address="$(cat "$STUB_STATE/next-address")"
    # open が起動する見張りは、thread の番号と重ならないようにする
    if [[ "${argv[0]}" == */bin/watch ]]; then address=t0w; fi
    status='{"app":"claude-code","state":"working"}'
    if [[ -f "$STUB_STATE/run-dialog" ]]; then status=null; fi
    if [[ -f "$STUB_STATE/run-silent" ]]; then
      status=null
      session=""
      for ((i = 0; i < ${#argv[@]}; i++)); do
        if [[ "${argv[i]}" == "--session-id" || "${argv[i]}" == "--resume" ]]; then session="${argv[i + 1]}"; fi
      done
      mkdir -p "$CLAUDE_CONFIG_DIR/projects/stub"
      # 本物もメッセージの前にほかの行を書く
      jq -cn --arg text "${argv[${#argv[@]} - 1]}" '{type: "mode"}, {type: "user", message: {role: "user", content: $text}}' \
        >> "$CLAUDE_CONFIG_DIR/projects/stub/$session.jsonl"
    fi
    jq -n --arg address "$address" --arg cwd "$cwd" --argjson status "$status" \
      '{address: $address, state: "live", cwd: $cwd, status: $status, foreground: {argv: $ARGS.positional, cwd: $cwd}}' \
      --args -- "${argv[@]}" > "$STUB_STATE/get-$address.json"
    printf '{"address":"%s"}\n' "$address"
    ;;
  read) echo "TRUST DIALOG SCREEN" ;;
  send)
    if [[ -f "$STUB_STATE/send-fails" ]]; then
      echo "refused" >&2
      exit 1
    fi
    ;;
  kill)
    if [[ -f "$STUB_STATE/get-$1.json" ]]; then
      jq '.state = "finished"' "$STUB_STATE/get-$1.json" > "$STUB_STATE/killed.json"
      mv "$STUB_STATE/killed.json" "$STUB_STATE/get-$1.json"
    fi
    ;;
  rm)
    if [[ ! -f "$STUB_STATE/get-$1.json" ]]; then
      echo '{"error":{"kind":"not_found"}}'
      exit 3
    fi
    if [[ "$(jq -r .state "$STUB_STATE/get-$1.json")" == "live" ]]; then
      echo '{"error":{"kind":"still_running"}}'
      exit 1
    fi
    rm "$STUB_STATE/get-$1.json"
    ;;
  label)
    terminal="$1"
    shift
    if [[ -f "$STUB_STATE/get-$terminal.json" ]]; then
      for pair in "$@"; do
        jq --arg k "${pair%%=*}" --arg v "${pair#*=}" \
          'if $v == "" then del(.labels[$k]) else .labels[$k] = $v end' \
          "$STUB_STATE/get-$terminal.json" > "$STUB_STATE/labeled.json"
        mv "$STUB_STATE/labeled.json" "$STUB_STATE/get-$terminal.json"
      done
    fi
    # 本物は terminal の JSON を stdout に出す
    printf '{"address":"%s"}\n' "$terminal"
    ;;
  *)
    echo "stub hc: 知らないコマンド $cmd" >&2
    exit 2
    ;;
esac
